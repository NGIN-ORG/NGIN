<?xml version="1.0" encoding="utf-8"?>

<Package Name="NGIN.Diagnostics" Version="0.1.0">
  <Uses>
    <Package Name="NGIN.Log" Version="0.1" />
  </Uses>
  <Plugin Name="Diagnostics" Default="true">
    <RuntimeFiles>
      <File From="config/diagnostics.defaults.xml" To="config/diagnostics.defaults.xml" />
    </RuntimeFiles>
  </Plugin>
  <Compatibility>
    <Target OS="linux" />
    <Target OS="windows" />
    <Target OS="macos" />
  </Compatibility>
</Package>
