<?xml version="1.0" encoding="utf-8"?>
<Package xmlns:cmake="urn:ngin:integration:cmake" Name="NGIN.Reflection" Version="0.1.0">
  <Requires><Package Name="NGIN.Base" Compatible="0.1" Visibility="Public" /></Requires>
  <Exports><Library Name="Reflection" Default="true" /></Exports>
  <Integrations>
    <cmake:AddSubdirectory Source=".">
      <cmake:Cache Name="NGIN_REFLECTION_BUILD_TESTS" Value="OFF" Type="BOOL" />
      <cmake:Cache Name="NGIN_REFLECTION_BUILD_EXAMPLES" Value="OFF" Type="BOOL" />
      <cmake:Cache Name="NGIN_REFLECTION_BUILD_BENCHMARKS" Value="OFF" Type="BOOL" />
      <cmake:Target Export="Reflection" Name="NGIN::Reflection" />
    </cmake:AddSubdirectory>
  </Integrations>
</Package>
