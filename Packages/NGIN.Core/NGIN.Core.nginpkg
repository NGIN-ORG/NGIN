<?xml version="1.0" encoding="utf-8"?>
<Package xmlns:cmake="urn:ngin:integration:cmake" Name="NGIN.Core" Version="0.1.0">
  <Options><Boolean Name="Reflection" Default="false" Artifact="true" /></Options>
  <Requires>
    <Package Name="NGIN.Base" Compatible="0.1" Visibility="Public" />
    <Package Name="NGIN.Log" Compatible="0.1" Visibility="Public" />
    <When Option="Reflection" Equals="true">
      <Package Name="NGIN.Reflection" Compatible="0.1" Visibility="Public" />
    </When>
  </Requires>
  <Exports><Library Name="Core" Default="true" /></Exports>
  <Integrations>
    <cmake:AddSubdirectory Source=".">
      <cmake:Cache Name="NGIN_CORE_BUILD_TESTS" Value="OFF" Type="BOOL" />
      <cmake:Cache Name="NGIN_CORE_BUILD_EXAMPLES" Value="OFF" Type="BOOL" />
      <cmake:Cache Name="NGIN_CORE_BUILD_BENCHMARKS" Value="OFF" Type="BOOL" />
      <cmake:MapOption Option="Reflection" Cache="NGIN_CORE_FEATURE_REFLECTION" True="ON" False="OFF" Artifact="true" />
      <cmake:Target Export="Core" Name="NGIN::Core" />
    </cmake:AddSubdirectory>
  </Integrations>
</Package>
