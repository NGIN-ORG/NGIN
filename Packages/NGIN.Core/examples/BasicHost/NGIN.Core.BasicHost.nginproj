<?xml version="1.0" encoding="utf-8"?>

<Executable Name="NGIN.Core.BasicHost">
  <Uses>
    <Package Name="NGIN.Core" Version="0.1" />
  </Uses>
  <Build>
    <Source Include="*.cpp" />
  </Build>
  <Stage>
    <File From="app.cfg" To="app.cfg" />
    <File From="package.cfg" To="package.cfg" />
  </Stage>
</Executable>
