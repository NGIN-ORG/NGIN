<?xml version="1.0" encoding="utf-8"?>
<Package xmlns:cmake="urn:ngin:integration:cmake" Name="NGIN.Reflection.MetaGen" Version="0.1.0">
  <Requires><Package Name="NGIN.Reflection" Compatible="0.1" Visibility="Public" /></Requires>
  <Exports>
    <Tool Name="MetaGen" />
    <Action Name="ReflectionCodegen" Kind="Generate" Tool="MetaGen" Deterministic="true">
      <Inputs><Header Include="**/*.hpp" /></Inputs>
      <Outputs><Source Path="generated/reflection.generated.cpp" /></Outputs>
    </Action>
  </Exports>
  <Integrations>
    <cmake:AddSubdirectory Source=".">
      <cmake:Target Export="MetaGen" Name="ngin_reflection_metagen" />
    </cmake:AddSubdirectory>
  </Integrations>
</Package>
