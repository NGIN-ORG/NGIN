<?xml version="1.0" encoding="utf-8"?>

<Package xmlns:cmake="urn:ngin:adapter:cmake" Name="NGIN.Reflection.MetaGen" Version="0.1.0">
  <Uses>
    <Package Name="NGIN.Reflection" Version="0.1" Public="true" />
  </Uses>
  <Tool Name="MetaGen" />
  <Generator Name="ReflectionCodegen" Tool="MetaGen" Deterministic="true">
    <Inputs>
      <Header Include="**/*.hpp" />
    </Inputs>
    <Outputs>
      <Source Path="generated/reflection.generated.cpp" />
    </Outputs>
  </Generator>
  <Adapters>
    <cmake:AddSubdirectory Source=".">
      <cmake:Target Export="MetaGen" Name="ngin_reflection_metagen" />
    </cmake:AddSubdirectory>
  </Adapters>
</Package>
