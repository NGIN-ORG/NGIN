<?xml version="1.0" encoding="utf-8"?>

<Package xmlns:cmake="urn:ngin:adapter:cmake" Name="NGIN.Base" Version="0.1.0">
  <Library Name="Base" Default="true" />
  <Library Name="Foundation" />
  <Library Name="Execution" />
  <Library Name="IO" />
  <Library Name="Serialization" />
  <Library Name="Crypto" />
  <Library Name="Net" />
  <Library Name="NetTLS" />
  <Adapters>
    <cmake:AddSubdirectory Source=".">
      <cmake:Cache Name="NGIN_BASE_BUILD_TESTS" Value="OFF" Type="BOOL" />
      <cmake:Cache Name="NGIN_BASE_BUILD_EXAMPLES" Value="OFF" Type="BOOL" />
      <cmake:Cache Name="NGIN_BASE_BUILD_BENCHMARKS" Value="OFF" Type="BOOL" />
      <cmake:Target Export="Base" Name="NGIN::Base" />
      <cmake:Target Export="Foundation" Name="NGIN::Base::Foundation" />
      <cmake:Target Export="Execution" Name="NGIN::Base::Execution" />
      <cmake:Target Export="IO" Name="NGIN::Base::IO" />
      <cmake:Target Export="Serialization" Name="NGIN::Base::Serialization" />
      <cmake:Target Export="Crypto" Name="NGIN::Base::Crypto" />
      <cmake:Target Export="Net" Name="NGIN::Base::Net" />
      <cmake:Target Export="NetTLS" Name="NGIN::Base::NetTLS" />
    </cmake:AddSubdirectory>
  </Adapters>
</Package>
