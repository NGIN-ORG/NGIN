<?xml version="1.0" encoding="utf-8"?>
<Package SchemaVersion="4"
         Name="NGIN.Base"
         Version="0.1.0"
         CompatiblePlatformRange=">=0.1.0-alpha.1 &lt;0.2.0">
  <Build Backend="CMake" Mode="AddSubdirectory">
    <Options>
      <Option Name="NGIN_BASE_BUILD_TESTS" Value="OFF" />
      <Option Name="NGIN_BASE_BUILD_EXAMPLES" Value="OFF" />
      <Option Name="NGIN_BASE_BUILD_BENCHMARKS" Value="OFF" />
    </Options>
  </Build>
  <Library Name="NGIN.Base">
    <Exports>
      <LibraryTarget Name="NGIN::Base" Linkage="Static" />
      <LibraryTarget Name="NGIN::Base::Foundation" Linkage="Static" />
      <LibraryTarget Name="NGIN::Base::Execution" Linkage="Static" />
      <LibraryTarget Name="NGIN::Base::IO" Linkage="Static" />
      <LibraryTarget Name="NGIN::Base::Serialization" Linkage="Static" />
      <LibraryTarget Name="NGIN::Base::Crypto" Linkage="Static" />
      <LibraryTarget Name="NGIN::Base::Net" Linkage="Static" />
      <LibraryTarget Name="NGIN::Base::NetTLS" Linkage="Static" />
    </Exports>
  </Library>
  <Compatibility>
    <OperatingSystems>
      <OperatingSystem Name="linux" />
      <OperatingSystem Name="windows" />
      <OperatingSystem Name="macos" />
    </OperatingSystems>
  </Compatibility>
</Package>
