<?xml version="1.0" encoding="utf-8"?>
<Package xmlns:cmake="urn:ngin:integration:cmake" Name="SDL3" Version="3.4.12">
  <Exports><Library Name="SDL3" Default="true" /></Exports>
  <Integrations>
    <cmake:AddSubdirectory Source="../../Dependencies/ThirdParty/SDL">
      <cmake:Target Export="SDL3" Name="SDL3::SDL3-static" />
    </cmake:AddSubdirectory>
  </Integrations>
</Package>
