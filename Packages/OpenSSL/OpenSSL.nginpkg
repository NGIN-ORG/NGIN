<?xml version="1.0" encoding="utf-8"?>
<Package xmlns:cmake="urn:ngin:integration:cmake" Name="OpenSSL" Version="3.0.0">
  <Metadata>
    <Description>OpenSSL cryptography and TLS libraries.</Description>
    <License>Apache-2.0</License>
  </Metadata>
  <Exports>
    <Library Name="Crypto" Default="true">
      <Provides>
        <Capability Name="Crypto.Provider.openssl" Version="3.0.0" Domain="Link" />
        <Capability Name="Crypto.Algorithm.Random" Version="3.0.0" Domain="Link" />
        <Capability Name="Crypto.Algorithm.Sha256" Version="3.0.0" Domain="Link" />
        <Capability Name="Crypto.Algorithm.Sha512" Version="3.0.0" Domain="Link" />
        <Capability Name="Crypto.Algorithm.HmacSha256" Version="3.0.0" Domain="Link" />
        <Capability Name="Crypto.Algorithm.HmacSha512" Version="3.0.0" Domain="Link" />
        <Capability Name="Crypto.Algorithm.HkdfSha256" Version="3.0.0" Domain="Link" />
        <Capability Name="Crypto.Algorithm.HkdfSha512" Version="3.0.0" Domain="Link" />
        <Capability Name="Crypto.Algorithm.Pbkdf2Sha256" Version="3.0.0" Domain="Link" />
        <Capability Name="Crypto.Algorithm.Pbkdf2Sha512" Version="3.0.0" Domain="Link" />
        <Capability Name="Crypto.Algorithm.Aes128Gcm" Version="3.0.0" Domain="Link" />
        <Capability Name="Crypto.Algorithm.Aes256Gcm" Version="3.0.0" Domain="Link" />
        <Capability Name="Crypto.Algorithm.ChaCha20Poly1305" Version="3.0.0" Domain="Link" />
        <Capability Name="Crypto.Algorithm.Ed25519" Version="3.0.0" Domain="Link" />
        <Capability Name="Crypto.Algorithm.EcdsaP256Sha256" Version="3.0.0" Domain="Link" />
        <Capability Name="Crypto.Algorithm.RsaPssSha256" Version="3.0.0" Domain="Link" />
        <Capability Name="Crypto.Algorithm.RsaOaepSha256" Version="3.0.0" Domain="Link" />
        <Capability Name="Crypto.Algorithm.X25519" Version="3.0.0" Domain="Link" />
      </Provides>
    </Library>
    <Library Name="TLS">
      <Requires><Export Library="Crypto" Visibility="Public" /></Requires>
      <Provides><Capability Name="Net.TLS.Provider.openssl" Version="3.0.0" Domain="Link" /></Provides>
    </Library>
  </Exports>
  <Integrations>
    <cmake:Manual Source=".">
      <cmake:Target Export="Crypto" Name="OpenSSL::Crypto" />
      <cmake:Target Export="TLS" Name="OpenSSL::SSL" />
    </cmake:Manual>
  </Integrations>
  <Compatibility><Target OS="linux" /><Target OS="windows" /><Target OS="macos" /></Compatibility>
</Package>
