<?xml version="1.0" encoding="utf-8"?>
<Project Name="Hello.Native" Type="Application">
  <Build>
    <Source Include="src/**/*.cpp" />
  </Build>
  <Launch Name="Default" Default="true">
    <WorkingDirectory Path="." />
  </Launch>
  <Refinements>
    <Refinement>
      <Select><Configuration Name="Debug" /></Select>
      <Build><Define Name="HELLO_NATIVE_LOCAL_DEBUG" /></Build>
    </Refinement>
  </Refinements>
</Project>
