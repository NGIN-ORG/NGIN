<?xml version="1.0" encoding="utf-8"?>
<Project SchemaVersion="4"
         Name="NGIN.UI.MultiPage"
         Version="0.4.0"
         DefaultProfile="Debug">

  <Application>
    <Uses>
      <Runtime Name="NGIN.Core"
               Version=">=0.1.0 &lt;0.2.0"
               Scope="Target;Runtime">
        <Feature Name="Reflection" />
      </Runtime>
      <Package Name="NGIN.UI.Hosting"
               Version=">=0.4.0 &lt;0.5.0"
               Scope="Target;Runtime" />
      <Package Name="NGIN.UI.Backend.SDL3"
               Version=">=0.4.0 &lt;0.5.0"
               Scope="Target">
        <Feature Name="RuntimeNotices" />
      </Package>
      <Package Name="NGIN.UI"
               Version=">=0.4.0 &lt;0.5.0"
               Scope="Target">
        <Feature Name="RuntimeAssets" />
      </Package>
      <Package Name="NGIN.UI.Accessibility.Windows"
               Version=">=0.4.0 &lt;0.5.0"
               OperatingSystem="windows"
               Scope="Target" />
    </Uses>

    <Build>
      <Sources Path="src/**.cpp" />
    </Build>

    <Launch Executable="NGIN.UI.MultiPage"
            WorkingDirectory="." />
  </Application>

  <Profile Name="Debug">
    <Defaults>
      <Optimization Mode="Off" />
      <DebugSymbols Enabled="true" />
      <LinkTimeOptimization Enabled="false" />
      <TargetPlatform Name="host" />
      <Environment Name="local" />
    </Defaults>
  </Profile>

  <Profile Name="Release">
    <Defaults>
      <Optimization Mode="Speed" />
      <DebugSymbols Enabled="false" />
      <LinkTimeOptimization Enabled="false" />
      <TargetPlatform Name="host" />
      <Environment Name="shipping" />
    </Defaults>
  </Profile>
</Project>
