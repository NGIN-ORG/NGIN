<?xml version="1.0" encoding="utf-8"?>
<Project SchemaVersion="4"
         Name="NGIN.UI.Gallery.Tests"
         Version="0.2.0"
         DefaultProfile="Debug">

  <Test>
    <Uses>
      <Package Name="NGIN.UI"
               Version=">=0.2.0 &lt;0.3.0"
               Scope="Target" />
    </Uses>

    <Build>
      <Sources Path="src/**.cpp" />
      <Sources Path="../NGIN.UI.Gallery/src/Gallery*.cpp" />
      <IncludePath Path="../NGIN.UI.Gallery/include" />
    </Build>

    <Run Name="unit"
         WorkingDirectory="." />
  </Test>

  <Profile Name="Debug">
    <Defaults>
      <Optimization Mode="Off" />
      <DebugSymbols Enabled="true" />
      <LinkTimeOptimization Enabled="false" />
      <TargetPlatform Name="host" />
      <Environment Name="local" />
    </Defaults>
  </Profile>

  <Profile Name="Release">
    <Defaults>
      <Optimization Mode="Speed" />
      <DebugSymbols Enabled="false" />
      <LinkTimeOptimization Enabled="false" />
      <TargetPlatform Name="host" />
      <Environment Name="shipping" />
    </Defaults>
  </Profile>
</Project>
