<?xml version="1.0" encoding="utf-8"?>

<Executable Name="NGIN.UI.Gallery.Tests" Version="0.4.0">
  <Uses>
    <Project Path="../NGIN.UI.Gallery/NGIN.UI.Gallery.Shared.nginproj" />
    <Package Name="NGIN.Reflection" Version="0.1" />
    <Package Name="NGIN.UI" Version="0.4" />
  </Uses>
  <Build>
    <Source Include="src/**/*.cpp" />
  </Build>
  <Stage>
    <File From="../NGIN.UI.Gallery/assets/fonts/Inter/Inter-Variable.ttf" To="fonts/Gallery/Inter-Variable.ttf" />
    <File From="../NGIN.UI.Gallery/assets/fonts/Inter/OFL.txt" To="licenses/NGIN.UI.Gallery/Inter-OFL.txt" />
  </Stage>
  <Test Timeout="60" />
</Executable>
