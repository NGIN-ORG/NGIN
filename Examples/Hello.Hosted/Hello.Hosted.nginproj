<?xml version="1.0" encoding="utf-8"?>
<Project Name="Hello.Hosted" Type="Application">
  <Dependencies>
    <Package Name="NGIN.Core" Compatible="0.1" />
  </Dependencies>
  <Build><Source Include="src/**/*.cpp" /></Build>
  <Stage><File Include="config/app.cfg" Into="config/app.cfg" /></Stage>
  <Launch Name="Default" Default="true"><WorkingDirectory Path="." /></Launch>
</Project>
