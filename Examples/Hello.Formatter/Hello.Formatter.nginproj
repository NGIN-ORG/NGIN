<?xml version="1.0" encoding="utf-8"?>

<Project Name="Hello.Formatter" Type="Application">
  <Build>
    <Source Include="src/**/*.cpp" />
  </Build>
  <Tooling>
    <Format Action="NGIN.Tooling.ClangFormat::Format" />
  </Tooling>
  <Launch Name="Default" Default="true">
    <WorkingDirectory Path="." />
  </Launch>
</Project>
