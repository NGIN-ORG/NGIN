<?xml version="1.0" encoding="utf-8"?>
<Project Name="NGIN.UI.Gallery.Hosted" Type="Application" Version="0.4.0">
  <Dependencies>
    <Package Name="NGIN.Core" Compatible="0.1" />
    <Package Name="NGIN.UI.Hosting" Compatible="0.4" />
    <Package Name="NGIN.UI.Backend.SDL3" Compatible="0.4" />
    <Package Name="NGIN.UI" Compatible="0.4" />
  </Dependencies>
  <Build>
    <Source Include="src/**/*.cpp" />
    <Source Include="../NGIN.UI.Gallery/src/Gallery*.cpp" />
    <IncludeDirectory Path="../NGIN.UI.Gallery/include" />
  </Build>
  <Stage>
    <File Include="../NGIN.UI.Gallery/assets/images/gallery-sample.png" Into="images/gallery-sample.png" />
    <File Include="../NGIN.UI.Gallery/RELEASE.md" Into="README.md" />
    <File Include="../../LICENSE" Into="licenses/NGIN/LICENSE" />
  </Stage>
  <Launch Name="Default" Default="true"><WorkingDirectory Path="." /></Launch>
  <Refinements>
    <Refinement>
      <Select><Target OS="windows" /></Select>
      <Dependencies><Package Name="NGIN.UI.Accessibility.Windows" Compatible="0.4" /></Dependencies>
    </Refinement>
  </Refinements>
</Project>
