<?xml version="1.0" encoding="utf-8"?>

<Executable Name="NGIN.UI.Gallery.Hosted" Version="0.4.0">
  <Uses>
    <Project Path="../NGIN.UI.Gallery/NGIN.UI.Gallery.Shared.nginproj" />
    <Package Name="NGIN.Core" Version="0.1" />
    <Package Name="NGIN.UI.Hosting" Version="0.4" />
    <Capability Name="NGIN.UI.Backend" Version="1" />
    <Package Name="NGIN.UI" Version="0.4" />
  </Uses>
  <Build>
    <Source Include="src/**/*.cpp" />
  </Build>
  <Stage>
    <File From="../NGIN.UI.Gallery/assets/images/gallery-sample.png" To="images/gallery-sample.png" />
    <File From="../NGIN.UI.Gallery/RELEASE.md" To="README.md" />
    <File From="../../LICENSE" To="licenses/NGIN/LICENSE" />
  </Stage>
  <When OS="windows">
    <Uses>
      <Package Name="NGIN.UI.Accessibility.Windows" Version="0.4" />
    </Uses>
  </When>
</Executable>
