<?xml version="1.0" encoding="utf-8"?>

<Library Name="NGIN.UI.Gallery.Shared" Kind="Static" Version="0.4.0">
  <Uses>
    <Package Name="NGIN.UI" Version="0.4" />
  </Uses>
  <Build Conventions="false">
    <Source Include="src/Gallery*.cpp" />
    <Header Include="include/**/*.hpp" Visibility="Public" />
    <IncludeDirectory Path="include" Visibility="Public" />
  </Build>
</Library>
