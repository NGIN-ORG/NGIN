<?xml version="1.0" encoding="utf-8"?>
<Project Name="NGIN.UI.Gallery" Type="Application" Version="0.4.0">
  <Dependencies>
    <Package Name="NGIN.UI.Backend.SDL3" Compatible="0.4" />
    <Package Name="NGIN.UI" Compatible="0.4" />
  </Dependencies>
  <Build>
    <Source Include="src/**/*.cpp" />
    <IncludeDirectory Path="include" />
  </Build>
  <Stage>
    <File Include="assets/images/gallery-sample.png" Into="images/gallery-sample.png" />
    <File Include="RELEASE.md" Into="README.md" />
    <File Include="../../LICENSE" Into="licenses/NGIN/LICENSE" />
  </Stage>
  <Launch Name="Default" Default="true"><WorkingDirectory Path="." /></Launch>
  <Publish Name="demo"><Archive Format="zip" Output="dist/NGIN.UI.Gallery-${project.version}-demo.zip" /></Publish>
  <Refinements>
    <Refinement>
      <Select><Target OS="windows" /></Select>
      <Dependencies><Package Name="NGIN.UI.Accessibility.Windows" Compatible="0.4" /></Dependencies>
    </Refinement>
  </Refinements>
</Project>
