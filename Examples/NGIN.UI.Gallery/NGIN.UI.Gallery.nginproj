<?xml version="1.0" encoding="utf-8"?>
<Project SchemaVersion="4"
         Name="NGIN.UI.Gallery"
         DefaultProfile="Debug">

  <Application>
    <Uses>
      <Package Name="NGIN.UI.Backend.SDL3"
               Version=">=0.1.0 &lt;0.2.0"
               Scope="Target">
        <Feature Name="RuntimeNotices" />
      </Package>
      <Package Name="NGIN.UI"
               Version=">=0.1.0 &lt;0.2.0"
               Scope="Target">
        <Feature Name="RuntimeAssets" />
      </Package>
    </Uses>

    <Build>
      <Sources Path="src/**.cpp" />
      <IncludePath Path="include" />
    </Build>

    <Stage>
      <Content Source="assets/images/gallery-sample.png"
               Target="images/gallery-sample.png" />
    </Stage>

    <Launch Executable="NGIN.UI.Gallery"
            WorkingDirectory="." />
  </Application>

  <Profile Name="Debug">
    <Defaults>
      <Optimization Mode="Off" />
      <DebugSymbols Enabled="true" />
      <LinkTimeOptimization Enabled="false" />
      <TargetPlatform Name="host" />
      <Environment Name="local" />
    </Defaults>
  </Profile>
</Project>
