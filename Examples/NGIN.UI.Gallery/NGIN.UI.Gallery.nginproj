<?xml version="1.0" encoding="utf-8"?>

<Executable Name="NGIN.UI.Gallery" Version="0.4.0">
  <Uses>
    <Project Path="NGIN.UI.Gallery.Shared.nginproj" />
    <Capability Name="NGIN.UI.Backend" Version="1" />
    <Package Name="NGIN.UI" Version="0.4" />
  </Uses>
  <Build>
    <Source Include="src/main.cpp" />
  </Build>
  <Stage>
    <File From="assets/images/gallery-sample.png" To="images/gallery-sample.png" />
    <File From="RELEASE.md" To="README.md" />
    <File From="../../LICENSE" To="licenses/NGIN/LICENSE" />
  </Stage>
  <Publish>
    <Archive Name="demo" Format="zip" Output="dist/NGIN.UI.Gallery-${project.version}-demo.zip" />
  </Publish>
  <When OS="windows">
    <Uses>
      <Package Name="NGIN.UI.Accessibility.Windows" Version="0.4" />
    </Uses>
  </When>
</Executable>
