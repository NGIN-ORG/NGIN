<?xml version="1.0" encoding="utf-8"?>
<Project Name="Hello.GameOfLife" Type="Application" Version="0.1.0">
  <Dependencies>
    <Package Name="NGIN.ECS" Compatible="0.4" />
    <Package Name="NGIN.UI.Backend.SDL3" Compatible="0.4" />
    <Package Name="NGIN.UI" Compatible="0.4" />
  </Dependencies>
  <Build><Source Include="src/**/*.cpp" /></Build>
  <Stage><File Include="../../LICENSE" Into="licenses/NGIN/LICENSE" /></Stage>
  <Launch Name="Default" Default="true"><WorkingDirectory Path="." /></Launch>
</Project>
