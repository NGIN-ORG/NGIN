<?xml version="1.0" encoding="utf-8"?>

<Executable Name="NGIN.CLI" Version="0.1.0">
  <Options>
    <Boolean Name="BundledTools" Default="false" Artifact="true" />
  </Options>
  <Uses>
    <Package Name="NGIN.Base" Version="0.1" />
  </Uses>
  <Build>
    <Source Include="src/**/*.cpp" />
    <Source Remove="src/ManifestSchemaGenerator.cpp" />
    <IncludeDirectory Path="src" Visibility="Private" />
    <Define Name="NGIN_CLI_VERSION" Value="&quot;0.1.0&quot;" Visibility="Private" />
  </Build>
  <Stage>
    <File From="../../LICENSE" To="share/ngin/licenses/LICENSE" />
    <File From="../ThirdParty/BuildTools/notices/THIRD_PARTY_TOOLS.md" To="share/ngin/licenses/THIRD_PARTY_TOOLS.md" />
  </Stage>
  <Publish>
    <Archive Name="linux-tgz" Format="tgz" Output="dist/ngin-${project.version}-linux-x86_64.tgz" />
    <Installer Name="linux-deb" Format="deb" Output="dist/ngin-${project.version}-linux-x86_64.deb" />
    <Archive Name="windows-zip" Format="zip" Output="dist/ngin-${project.version}-windows-x86_64.zip" />
    <Installer Name="windows-msi" Format="msi" Output="dist/ngin-${project.version}-windows-x86_64.msi" />
  </Publish>
  <When OS="linux">
    <Build>
      <LinkOption Value="-static-libstdc++" />
      <LinkOption Value="-static-libgcc" />
    </Build>
  </When>
  <When Option="BundledTools" Equals="true">
    <Stage>
      <File From="../ThirdParty/BuildTools/toolchains.json" To="share/ngin/tools/toolchains.json" />
      <Directory From="../ThirdParty/BuildTools/notices" To="share/ngin/tools/notices" />
      <Directory From="../ThirdParty/BuildTools/cmake" To="share/ngin/tools/cmake" />
      <Directory From="../ThirdParty/BuildTools/ninja" To="share/ngin/tools/ninja" />
    </Stage>
  </When>
</Executable>
