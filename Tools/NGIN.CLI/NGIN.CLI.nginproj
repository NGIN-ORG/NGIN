<?xml version="1.0" encoding="utf-8"?>
<Project Name="NGIN.CLI" Type="Tool" Version="0.1.0">
  <Options>
    <Boolean Name="BundledTools" Default="false" Artifact="true" />
  </Options>
  <Dependencies>
    <Package Name="NGIN.Base" Compatible="0.1" />
  </Dependencies>
  <Build>
    <Source Include="src/**/*.cpp" />
    <Source Remove="src/ManifestSchemaGenerator.cpp" />
    <IncludeDirectory Path="src" Visibility="Private" />
    <Define Name="NGIN_CLI_VERSION" Value="&quot;0.1.0&quot;" Visibility="Private" />
  </Build>
  <Stage>
    <File Include="../../LICENSE" Into="share/ngin/licenses/LICENSE" />
    <File Include="../ThirdParty/BuildTools/notices/THIRD_PARTY_TOOLS.md" Into="share/ngin/licenses/THIRD_PARTY_TOOLS.md" />
  </Stage>
  <Publish Name="linux-tgz"><Archive Format="tgz" Output="dist/ngin-${project.version}-linux-x86_64.tgz" /></Publish>
  <Publish Name="linux-deb"><Installer Format="deb" Output="dist/ngin-${project.version}-linux-x86_64.deb" /></Publish>
  <Publish Name="windows-zip"><Archive Format="zip" Output="dist/ngin-${project.version}-windows-x86_64.zip" /></Publish>
  <Publish Name="windows-msi"><Installer Format="msi" Output="dist/ngin-${project.version}-windows-x86_64.msi" /></Publish>
  <Refinements>
    <Refinement>
      <Select><Target OS="linux" /></Select>
      <Build>
        <LinkOption Value="-static-libstdc++" />
        <LinkOption Value="-static-libgcc" />
      </Build>
    </Refinement>
    <Refinement>
      <Select><Option Name="BundledTools" Value="true" /></Select>
      <Stage>
        <File Include="../ThirdParty/BuildTools/toolchains.json" Into="share/ngin/tools/toolchains.json" />
        <Directory Include="../ThirdParty/BuildTools/notices" Into="share/ngin/tools/notices" />
        <Directory Include="../ThirdParty/BuildTools/cmake" Into="share/ngin/tools/cmake" />
        <Directory Include="../ThirdParty/BuildTools/ninja" Into="share/ngin/tools/ninja" />
      </Stage>
    </Refinement>
  </Refinements>
</Project>
