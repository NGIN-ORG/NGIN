<?xml version="1.0" encoding="utf-8"?>

<Executable Name="ProjectRef.Config.Root">
  <Uses>
    <Project Path="../Library/ProjectRef.Config.Library.nginproj" />
  </Uses>
  <Build>
    <Source Include="src/**/*.cpp" />
  </Build>
  <Stage>
    <File From="config/root.cfg" To="config/root.cfg" />
  </Stage>
</Executable>
