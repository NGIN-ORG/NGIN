<?xml version="1.0" encoding="utf-8"?>

<Executable Name="Gallery" Version="0.4.0">
  <Uses>
    <Package Name="NGIN.Core" Version="0.4" />
    <Package Name="NGIN.UI" Version="0.4" />
    <Package Name="NGIN.UI.Hosting" Version="0.4" />
    <Package Name="NGIN.UI.Backend.SDL3" Version="0.4" />
  </Uses>
  <Build>
    <Source Include="src/**.cpp" />
    <Resource Include="assets/**" Into="assets" />
  </Build>
  <Stage>
    <File From="config/app.cfg" To="config/app.cfg" />
  </Stage>
  <Run Name="Development">
    <Argument>--gallery</Argument>
  </Run>
</Executable>
