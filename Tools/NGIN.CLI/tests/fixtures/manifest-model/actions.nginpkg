<?xml version="1.0" encoding="utf-8"?>

<Package xmlns:cmake="urn:ngin:adapter:cmake" Name="Example.MetaGen" Version="1.0.0">
  <Tool Name="MetaGen" />
  <Generator Name="GenerateMetadata" Tool="MetaGen">
    <Inputs>
      <Header Include="include/**.hpp" />
    </Inputs>
    <Outputs>
      <Source Path="generated/metadata.cpp" />
    </Outputs>
  </Generator>
  <Adapters>
    <cmake:AddSubdirectory Source=".">
      <cmake:Target Export="MetaGen" Name="Example.MetaGen" />
    </cmake:AddSubdirectory>
  </Adapters>
</Package>
