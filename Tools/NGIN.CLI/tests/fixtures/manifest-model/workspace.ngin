<?xml version="1.0" encoding="utf-8"?>

<Workspace Name="Fixture.Workspace">
  <Discover>
    <Projects Include="*.nginproj" />
    <Packages Include="*.nginpkg" />
  </Discover>
  <Targets>
    <Target Name="win-x64" OS="windows" Architecture="x64">
      <Alias Name="windows-desktop" />
    </Target>
  </Targets>
  <Versions>
    <Package Name="NGIN.Base" Version="0.4" />
  </Versions>
  <Profiles Default="dev">
    <Profile Name="dev" Configuration="Debug" Target="host" Toolchain="auto" />
  </Profiles>
</Workspace>
