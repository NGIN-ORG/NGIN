<?xml version="1.0" encoding="utf-8"?>

<Library Name="Example.Telemetry" Kind="Plugin" Version="1.0.0">
  <Uses>
    <Package Name="NGIN.Base" Version="0.4" />
  </Uses>
  <Build>
    <Source Include="src/**.cpp" />
    <Header Include="include/**.hpp" Visibility="Private" />
  </Build>
  <Publish>
    <Archive Name="plugin-package" Format="zip" Output="dist/${project.name}-${project.version}.zip" />
  </Publish>
</Library>
