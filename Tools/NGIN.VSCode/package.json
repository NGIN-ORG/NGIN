    "submenus": [
      {
        "id": "ngin.sourceMenu",
        "label": "NGIN"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "ngin.createProject",
          "when": "view == ngin.projects && workspaceFolderCount > 0",
          "group": "navigation@1"
        },
        {
          "command": "ngin.locateActiveFile",
          "when": "view == ngin.projects && ngin.hasProjects",
          "group": "navigation@2"
        },
        {
          "command": "ngin.toggleIgnoredFiles",
          "when": "view == ngin.projects && ngin.hasProjects",
          "group": "navigation@3"
        },
        {
          "command": "ngin.refresh",
          "when": "view == ngin.projects",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "ngin.openDevelopmentProject",
          "when": "view == ngin.projects && (viewItem == nginWorkspacePackageDevelopment || viewItem == nginDirectPackageDevelopment || viewItem == nginTransitivePackageDevelopment)",
          "group": "1_navigation@1"
        },
        {
          "command": "ngin.showConsumingProjects",
          "when": "view == ngin.projects && (viewItem == nginWorkspacePackage || viewItem == nginWorkspacePackageDevelopment)",
          "group": "1_navigation@2"
        },
        {
          "command": "ngin.showExportedTargets",
          "when": "view == ngin.projects && (viewItem == nginWorkspacePackage || viewItem == nginWorkspacePackageDevelopment)",
          "group": "1_navigation@3"
        },
        {
          "command": "ngin.setLaunchProduct",
          "when": "view == ngin.projects && viewItem =~ /^nginCMakeProjectRoot/",
          "group": "1_project@1"
        },
        {
          "command": "ngin.selectConfigurePreset",
          "when": "view == ngin.projects && viewItem =~ /^nginCMakeProjectRoot/",
          "group": "1_project@2"
        },
        {
          "command": "ngin.configure",
          "when": "view == ngin.projects && viewItem =~ /^nginCMakeProjectRoot/ && isWorkspaceTrusted",
          "group": "2_lifecycle@1"
        },
        {
          "command": "ngin.build",
          "when": "view == ngin.projects && viewItem =~ /^nginCMakeProjectRoot/ && isWorkspaceTrusted",
          "group": "inline@1"
        },
        {
          "command": "ngin.build",
          "when": "view == ngin.projects && viewItem =~ /^nginCMakeProjectRoot/ && isWorkspaceTrusted",
          "group": "2_lifecycle@2"
        },
        {
          "command": "ngin.test",
          "when": "view == ngin.projects && viewItem =~ /^nginCMakeProjectRoot/ && isWorkspaceTrusted",
          "group": "2_lifecycle@3"
        },
        {
          "command": "ngin.build",
          "when": "view == ngin.projects && viewItem == nginCMakeTestsGroup && isWorkspaceTrusted",
          "group": "2_tests@1"
        },
        {
          "command": "ngin.runCMakeTests",
          "when": "view == ngin.projects && viewItem == nginCMakeTestsGroup && isWorkspaceTrusted",
          "group": "2_tests@2"
        },
        {
          "command": "ngin.runCMakeTest",
          "when": "view == ngin.projects && viewItem == nginCMakeTest && isWorkspaceTrusted",
          "group": "2_test@1"
        },
        {
          "command": "ngin.build",
          "when": "view == ngin.projects && viewItem == nginCMakeTestNotBuilt && isWorkspaceTrusted",
          "group": "2_test@1"
        },
        {
          "command": "ngin.openCMakeProject",
          "when": "view == ngin.projects && viewItem =~ /^nginCMakeProjectRoot/",
          "group": "3_project@1"
        },
        {
          "command": "ngin.refreshCMakeProject",
          "when": "view == ngin.projects && viewItem =~ /^nginCMakeProjectRoot/",
          "group": "3_project@2"
        },
        {
          "command": "ngin.buildCMakeTarget",
          "when": "view == ngin.projects && viewItem =~ /^nginCMakeTarget/ && isWorkspaceTrusted",
          "group": "inline@1"
        },
        {
          "command": "ngin.openCMakeDeclaration",
          "when": "view == ngin.projects && viewItem =~ /^nginCMakeTarget/",
          "group": "1_target@1"
        },
        {
          "command": "ngin.showCMakeArtifacts",
          "when": "view == ngin.projects && viewItem =~ /^nginCMakeTarget/",
          "group": "1_target@2"
        },
        {
          "command": "ngin.addPackage",
          "when": "view == ngin.projects && viewItem == nginPackagesGroup",
          "group": "1_packages@1"
        },
        {
          "command": "ngin.restore",
          "when": "view == ngin.projects && viewItem == nginPackagesGroup",
          "group": "1_packages@2"
        },
        {
          "command": "ngin.lock",
          "when": "view == ngin.projects && viewItem == nginPackagesGroup",
          "group": "1_packages@3"
        },
        {
          "command": "ngin.showGraph",
          "when": "view == ngin.projects && viewItem == nginPackagesGroup",
          "group": "2_packages@1"
        },
        {
          "command": "ngin.changePackageRequirement",
          "when": "view == ngin.projects && (viewItem == nginDirectPackage || viewItem == nginDirectPackageDevelopment)",
          "group": "1_package@1"
        },
        {
          "command": "ngin.removePackage",
          "when": "view == ngin.projects && (viewItem == nginDirectPackage || viewItem == nginDirectPackageDevelopment)",
          "group": "1_package@2"
        },
        {
          "command": "ngin.openGraphSource",
          "when": "view == ngin.projects && (viewItem == nginDirectPackage || viewItem == nginDirectPackageDevelopment || viewItem == nginTransitivePackage || viewItem == nginTransitivePackageDevelopment)",
          "group": "2_package@1"
        },
        {
          "command": "ngin.showGraph",
          "when": "view == ngin.projects && viewItem == nginExternalGroup",
          "group": "1_external@1"
        },
        {
          "command": "ngin.inspect",
          "when": "view == ngin.projects && viewItem == nginExternalGroup",
          "group": "1_external@2"
        },
        {
          "command": "ngin.openFile",
          "when": "view == ngin.projects && viewItem == nginProjectFile.external",
          "group": "1_externalFile@1"
        },
        {
          "command": "ngin.copyFilePath",
          "when": "view == ngin.projects && viewItem == nginProjectFile.external",
          "group": "1_externalFile@2"
        },
        {
          "command": "ngin.build",
          "when": "view == ngin.projects && viewItem =~ /^nginProductRoot/",
          "group": "inline@1"
        },
        {
          "command": "ngin.run",
          "when": "view == ngin.projects && viewItem =~ /^nginProductRoot.*\\.run(\\.|$)/",
          "group": "inline@2"
        },
        {
          "command": "ngin.debug",
          "when": "view == ngin.projects && viewItem =~ /^nginProductRoot.*\\.run(\\.|$)/",
          "group": "inline@3"
        },
        {
          "command": "ngin.setLaunchProduct",
          "when": "view == ngin.projects && viewItem =~ /^nginProductRoot/",
          "group": "1_project@1"
        },
        {
          "command": "ngin.configure",
          "when": "view == ngin.projects && viewItem =~ /^nginProductRoot/",
          "group": "2_lifecycle@1"
        },
        {
          "command": "ngin.build",
          "when": "view == ngin.projects && viewItem =~ /^nginProductRoot/",
          "group": "2_lifecycle@2"
        },
        {
          "command": "ngin.run",
          "when": "view == ngin.projects && viewItem =~ /^nginProductRoot.*\\.run(\\.|$)/",
          "group": "2_lifecycle@3"
        },
        {
          "command": "ngin.debug",
          "when": "view == ngin.projects && viewItem =~ /^nginProductRoot.*\\.run(\\.|$)/",
          "group": "2_lifecycle@4"
        },
        {
          "command": "ngin.rebuild",
          "when": "view == ngin.projects && viewItem =~ /^nginProductRoot/",
          "group": "2_lifecycle@5"
        },
        {
          "command": "ngin.clean",
          "when": "view == ngin.projects && viewItem =~ /^nginProductRoot/",
          "group": "2_lifecycle@6"
        },
        {
          "command": "ngin.projectActions",
          "when": "view == ngin.projects && viewItem =~ /^nginProductRoot/",
          "group": "3_project@1"
        },
        {
          "command": "ngin.openManifest",
          "when": "view == ngin.projects && viewItem =~ /^nginProductRoot/",
          "group": "3_project@2"
        },
        {
          "command": "ngin.openOutputDirectory",
          "when": "view == ngin.projects && viewItem =~ /^nginProductRoot/",
          "group": "3_project@3"
        },
        {
          "command": "ngin.newFile",
          "when": "view == ngin.projects && (viewItem =~ /^nginProductRoot/ || viewItem =~ /^nginProjectDirectory/)",
          "group": "3_project@4"
        },
        {
          "command": "ngin.newFolder",
          "when": "view == ngin.projects && (viewItem =~ /^nginProductRoot/ || viewItem =~ /^nginProjectDirectory/)",
          "group": "3_project@5"
        },
        {
          "command": "ngin.newSourceFile",
          "when": "view == ngin.projects && (viewItem =~ /^nginProductRoot/ || viewItem =~ /^nginProjectDirectory/)",
          "group": "3_project@6"
        },
        {
          "command": "ngin.newHeaderFile",
          "when": "view == ngin.projects && (viewItem =~ /^nginProductRoot/ || viewItem =~ /^nginProjectDirectory/)",
          "group": "3_project@7"
        },
        {
          "command": "ngin.importItems",
          "when": "view == ngin.projects && (viewItem =~ /^nginProductRoot/ || viewItem =~ /^nginProjectDirectory/)",
          "group": "3_project@8"
        },
        {
          "command": "ngin.changeMembership",
          "when": "view == ngin.projects && viewItem =~ /^nginProjectFile/ && resourceExtname =~ /\\.(c|cc|cpp|cxx|h|hh|hpp|hxx|ixx|cppm)$/",
          "group": "4_file@1"
        },
        {
          "command": "ngin.analyzeFile",
          "when": "view == ngin.projects && viewItem =~ /^nginProjectFile/ && resourceExtname =~ /\\.(c|cc|cpp|cxx|h|hh|hpp|hxx|ixx|cppm)$/",
          "group": "4_file@2"
        },
        {
          "command": "ngin.formatFile",
          "when": "view == ngin.projects && viewItem =~ /^nginProjectFile/ && resourceExtname =~ /\\.(c|cc|cpp|cxx|h|hh|hpp|hxx|ixx|cppm)$/",
          "group": "4_file@3"
        },
        {
          "command": "ngin.revealProjectFile",
          "when": "view == ngin.projects && viewItem =~ /^nginProjectFile/",
          "group": "4_file@4"
        },
        {
          "command": "ngin.renameItem",
          "when": "view == ngin.projects && viewItem =~ /^nginProjectFile\\.(ordinary|candidate|selected|input)$/",
          "group": "5_manage@1"
        },
        {
          "command": "ngin.moveItem",
          "when": "view == ngin.projects && viewItem =~ /^nginProjectFile\\.(ordinary|candidate|selected|input)$/",
          "group": "5_manage@2"
        },
        {
          "command": "ngin.deleteItem",
          "when": "view == ngin.projects && viewItem =~ /^nginProjectFile\\.(ordinary|candidate|selected|input)$/",
          "group": "5_manage@3"
        },
        {
          "command": "ngin.duplicateItem",
          "when": "view == ngin.projects && viewItem =~ /^nginProjectFile\\.(ordinary|candidate|selected|input)$/",
          "group": "5_manage@4"
        }
      ],
      "editor/title": [
        {
          "command": "ngin.validateManifest",
          "when": "editorLangId == ngin",
          "group": "navigation@1"
        },
        {
          "command": "ngin.formatManifest",
          "when": "editorLangId == ngin",
          "group": "navigation@2"
        }
      ],
      "editor/context": [
        {
          "submenu": "ngin.sourceMenu",
          "when": "resourceScheme == file",
          "group": "navigation@20"
        }
      ],
      "explorer/context": [
        {
          "submenu": "ngin.sourceMenu",
          "when": "resourceScheme == file",
          "group": "navigation@20"
        }
      ],
      "ngin.sourceMenu": [
        {
          "command": "ngin.analyzeFile",
          "when": "resourceExtname =~ /\\.(c|cc|cpp|cxx|h|hh|hpp|hxx|ixx|cppm)$/",
          "group": "1_tooling@1"
        },
        {
          "command": "ngin.formatFile",
          "when": "resourceExtname =~ /\\.(c|cc|cpp|cxx|h|hh|hpp|hxx|ixx|cppm)$/",
          "group": "1_tooling@2"
        },
        {
          "command": "ngin.changeMembership",
          "when": "resourceExtname =~ /\\.(c|cc|cpp|cxx|h|hh|hpp|hxx|ixx|cppm)$/",
          "group": "2_membership@1"
        },
        {
          "command": "ngin.revealOwningProject",
          "group": "3_navigation@1"
        }
      ],
      "commandPalette": [
        {
          "command": "ngin.cancel",
          "when": "ngin.busy"
        },
        {
          "command": "ngin.openGraphSource",
          "when": "false"
        },
        {
          "command": "ngin.includeFile",
          "when": "false"
        },
        {
          "command": "ngin.excludeFile",
          "when": "false"
        },
        {
          "command": "ngin.changeMembership",
          "when": "false"
        },
        {
          "command": "ngin.revealOwningProject",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "NGIN",
      "properties": {
        "ngin.executable": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to the `ngin` executable. Empty automatically uses the repository development build when present, then `ngin` on PATH."
        },
        "ngin.validateOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Validate the active NGIN project after saving an NGIN manifest."
        },
        "ngin.analysis.mode": {
          "type": "string",
          "enum": ["off", "openAndSave"],
          "enumDescriptions": [
            "Do not run project analyzers automatically.",
            "Analyze C and C++ files when they are opened or saved."
          ],
          "default": "openAndSave",
          "description": "Run resolved project analyzers when a C/C++ file is opened or saved."
        },
        "ngin.analysis.debounceMs": {
          "type": "number",
          "minimum": 0,
          "default": 400,
          "description": "Delay before analyzing a saved source file."
        },
        "ngin.build.outputRoot": {
          "type": "string",
          "default": ".ngin/build",
          "description": "Workspace-relative or absolute root for extension-driven build output."
        },
        "ngin.output.verbosity": {
          "type": "string",
          "enum": ["compact", "commands", "trace"],
          "enumDescriptions": [
            "Show compact lifecycle summaries, user-requested output, and failures. Hide successful background commands and machine-readable payloads.",
            "Also show background CLI command lines, while keeping machine-readable payloads hidden.",
            "Show every CLI command and raw stdout/stderr, including JSON payloads and lifecycle protocol events."
          ],
          "default": "compact",
          "description": "Controls detail written to the NGIN Output channel."
        },
        "ngin.revealOutputOnRun": {
          "type": "boolean",
          "default": false,
          "description": "Reveal the NGIN output channel when starting a lifecycle command. Failures remain available through Problems and actionable error messages."
        },
        "ngin.statusBar.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show one compact NGIN project-context item in the status bar."
        },
        "ngin.workspace.showIgnoredFiles": {
          "type": "boolean",
          "default": false,
          "description": "Reveal normally hidden output, dependency, and excluded paths in the NGIN Workspace tree."
        },
        "ngin.decorations.mode": {
          "type": "string",
          "enum": ["off", "minimal", "detailed"],
          "enumDescriptions": [
            "Do not decorate files in the Explorer.",
            "Decorate only exceptional NGIN files such as generated inputs.",
            "Decorate included, excluded, generated, and project-owned files."
          ],
          "default": "minimal",
          "description": "Controls NGIN file decorations in the Explorer."
        },
        "ngin.cpp.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Provide compile-command configuration to the Microsoft C/C++ extension when installed."
        },
        "ngin.debug.miDebuggerPath": {
          "type": "string",
          "default": "",
          "description": "Optional GDB or LLDB executable for NGIN native debugging on Linux and macOS."
        }
      }
    },
    "taskDefinitions": [
      {
        "type": "ngin",
        "required": [
          "command"
        ],
        "properties": {
          "command": {
            "type": "string",
            "enum": [
              "configure",
              "build",
              "stage",
              "test",
              "benchmark",
              "restore"
            ]
          }
        }
      }
    ],
    "problemMatchers": [
      {
        "name": "ngin-file",
        "label": "NGIN manifest diagnostics",
        "owner": "ngin",
        "fileLocation": "absolute",
        "pattern": {
          "regexp": "^(.*):(\\d+):(\\d+):\\s+(error|warning)\\s+(NGIN\\d+):\\s+(.+)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "code": 5,
          "message": 6
        }
      }
    ],
    "debuggers": [
      {
        "type": "ngin",
        "label": "NGIN Native",
        "configurationAttributes": {
          "run": {
            "properties": {
              "project": {
                "type": "string",
                "description": "Optional .nginproj path; defaults to the project owning the active source file, then the default project."
              },
              "configuration": {
                "type": "string",
                "description": "Optional NGIN Configuration."
              },
              "target": {
                "type": "string",
                "description": "Optional NGIN Target."
              },
              "toolchain": {
                "type": "string",
                "description": "Optional NGIN Toolchain."
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": []
              },
              "preStage": {
                "type": "boolean",
                "default": true,
                "description": "Build and stage before starting the native debugger."
              },
              "test": {
                "type": "boolean",
                "default": false,
                "description": "Debug the resolved NGIN TestPlan instead of a Run definition."
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "ngin",
            "request": "run",
            "name": "NGIN: Debug Current Project",
            "preStage": true
          }
        ]
      }
    ]
  },
  "dependencies": {
    "vscode-cpptools": "^7.1.1"
  }
}
