{
  "name": "ngin-tools",
  "displayName": "NGIN Tools",
  "description": "A graph-driven project, build, run, debug, and XML authoring experience for NGIN.",
  "version": "0.1.0",
  "publisher": "ngin",
  "license": "Apache-2.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/NGIN-ORG/NGIN.git",
    "directory": "Tools/NGIN.VSCode"
  },
  "engines": {
    "vscode": "^1.86.0"
  },
  "categories": [
    "Programming Languages",
    "Debuggers",
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:**/*.ngin",
    "workspaceContains:**/*.nginproj",
    "onDebugResolve:ngin"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "watch": "node ./scripts/build.mjs --watch",
    "typecheck": "tsc -p ./tsconfig.json --noEmit",
    "test:unit": "node ./scripts/test.mjs",
    "test:integration": "npm run build && node ./scripts/test.mjs --compile-only && node ./dist-test/test/integration/runTest.js",
    "test": "npm run typecheck && npm run test:unit && npm run test:integration",
    "vscode:prepublish": "npm run build",
    "package": "vsce package --out ngin-tools.vsix"
  },
  "devDependencies": {
    "@secretlint/secretlint-rule-preset-recommend": "10.2.2",
    "@types/node": "^26.4.0",
    "@types/vscode": "^1.86.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.1",
    "ovsx": "^0.10.12",
    "typescript": "^6.0.3"
  },
  "contributes": {
    "languages": [
      {
        "id": "ngin",
        "aliases": [
          "NGIN Manifest"
        ],
        "extensions": [
          ".ngin",
          ".nginproj",
          ".nginpkg"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "ngin",
        "scopeName": "source.ngin",
        "path": "./syntaxes/ngin.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "ngin",
        "path": "./snippets/ngin.code-snippets"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ngin",
          "title": "NGIN",
          "icon": "media/ngin-activity.svg"
        }
      ]
    },
    "views": {
      "ngin": [
        {
          "id": "ngin.projects",
          "name": "Workspace",
          "icon": "media/ngin-activity.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "ngin.projects",
        "when": "workspaceFolderCount == 0",
        "contents": "Open a folder containing an NGIN project to get started.\n[Open Folder](command:workbench.action.files.openFolder)\n[Open Getting Started](command:ngin.openWalkthrough)"
      },
      {
        "view": "ngin.projects",
        "when": "workspaceFolderCount > 0 && !ngin.hasProjects",
        "contents": "No NGIN projects were found in this workspace.\n[Create NGIN Project](command:ngin.createProject)\n[Check Setup](command:ngin.checkSetup)\n[Open Getting Started](command:ngin.openWalkthrough)"
      }
    ],
    "walkthroughs": [
      {
        "id": "ngin.gettingStarted",
        "title": "Get started with NGIN",
        "description": "Set up the CLI, open or create a project, and run the native C++ workflow.",
        "steps": [
          {
            "id": "configureCli",
            "title": "Find the NGIN CLI",
            "description": "NGIN Tools uses the repository development build when available, then `ngin` on PATH. [Check setup](command:ngin.checkSetup) or [review NGIN settings](command:ngin.openSettings).",
            "media": { "image": "media/walkthrough/cli.svg", "altText": "NGIN setup check showing ready CLI, workspace trust, project discovery, and project model." },
            "completionEvents": ["onContext:ngin.cliReady"]
          },
          {
            "id": "openProject",
            "title": "Open or create a project",
            "description": "Open a workspace with a `.nginproj`, or [create an NGIN project](command:ngin.createProject).",
            "media": { "image": "media/walkthrough/project.svg", "altText": "NGIN Workspace tree with a selected project, physical folders, semantic overlays, Composition, Generated, and Issues." },
            "completionEvents": ["onCommand:ngin.createProject", "onContext:ngin.hasProject"]
          },
          {
            "id": "buildProject",
            "title": "Build, run, and debug",
            "description": "Use a project row or [open Project Actions](command:ngin.projectActions) to build and run. Press F5 to debug the project owning the active file.",
            "media": { "image": "media/walkthrough/build.svg", "altText": "NGIN Project Actions showing lifecycle commands and build-context selection from one status item." },
            "completionEvents": ["onContext:ngin.hasSuccessfulBuild", "onContext:ngin.hasSuccessfulRun"]
          },
          {
            "id": "enableTooling",
            "title": "Enable analyzers and formatters",
            "description": "Products can provide verified tooling through NGIN Actions. [Enable product tooling](command:ngin.enableProjectTooling) when your product declares it.",
            "media": { "image": "media/walkthrough/tooling.svg", "altText": "Analyzer warning shown in source and the native Problems view with Quick Fix support." },
            "completionEvents": ["onContext:ngin.toolingDecided"]
          }
        ]
      }
    ],
