{
  "name": "ngin-tools",
  "displayName": "NGIN Tools",
  "description": "XML authoring, semantic validation, and CLI workflows for NGIN manifests.",
  "version": "0.1.0",
  "publisher": "ngin",
  "license": "Apache-2.0",
  "private": true,
  "engines": { "vscode": "^1.86.0" },
  "categories": ["Programming Languages", "Other"],
  "activationEvents": ["onLanguage:ngin"],
  "main": "./dist/extension.js",
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "watch": "node ./scripts/build.mjs --watch",
    "typecheck": "tsc -p ./tsconfig.json --noEmit",
    "test": "npm run typecheck"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "@types/vscode": "^1.86.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.1",
    "ovsx": "^0.10.12",
    "typescript": "^6.0.3"
  },
  "contributes": {
    "languages": [{
      "id": "ngin",
      "aliases": ["NGIN Manifest"],
      "extensions": [".ngin", ".nginproj", ".nginpkg"],
      "configuration": "./language-configuration.json"
    }],
    "grammars": [{
      "language": "ngin",
      "scopeName": "source.ngin",
      "path": "./syntaxes/ngin.tmLanguage.json"
    }],
    "snippets": [{ "language": "ngin", "path": "./snippets/ngin.code-snippets" }],
    "commands": [
      { "command": "ngin.validateManifest", "title": "NGIN: Validate Manifest" },
      { "command": "ngin.formatManifest", "title": "NGIN: Format Manifest" },
      { "command": "ngin.showSchema", "title": "NGIN: Show Manifest Schema Metadata" }
    ],
    "menus": {
      "editor/title": [
        { "command": "ngin.validateManifest", "when": "editorLangId == ngin", "group": "navigation" },
        { "command": "ngin.formatManifest", "when": "editorLangId == ngin", "group": "navigation" }
      ]
    },
    "configuration": {
      "title": "NGIN",
      "properties": {
        "ngin.executable": {
          "type": "string",
          "default": "ngin",
          "description": "Path to the NGIN CLI executable used for semantic validation and formatting."
        },
        "ngin.validateOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Run semantic manifest validation after saving an NGIN XML document."
        }
      }
    }
  }
}
