{
  "name": "ngin-tools",
  "displayName": "NGIN Tools",
  "description": "A graph-driven project, build, run, debug, and XML authoring experience for NGIN.",
  "version": "0.1.0",
  "publisher": "ngin",
  "license": "Apache-2.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/NGIN-ORG/NGIN.git",
    "directory": "Tools/NGIN.VSCode"
  },
  "engines": {
    "vscode": "^1.86.0"
  },
  "categories": [
    "Programming Languages",
    "Debuggers",
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:**/*.ngin",
    "workspaceContains:**/*.nginproj",
    "onDebugResolve:ngin"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "watch": "node ./scripts/build.mjs --watch",
    "typecheck": "tsc -p ./tsconfig.json --noEmit",
    "test:unit": "node ./scripts/test.mjs",
    "test:integration": "npm run build && node ./scripts/test.mjs --compile-only && node ./dist-test/test/integration/runTest.js",
    "test": "npm run typecheck && npm run test:unit && npm run test:integration",
    "vscode:prepublish": "npm run build",
    "package": "vsce package --out ngin-tools.vsix"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "@types/vscode": "^1.86.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.1",
    "ovsx": "^0.10.12",
    "typescript": "^6.0.3"
  },
  "contributes": {
    "languages": [
      {
        "id": "ngin",
        "aliases": [
          "NGIN Manifest"
        ],
        "extensions": [
          ".ngin",
          ".nginproj",
          ".nginpkg"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "ngin",
        "scopeName": "source.ngin",
        "path": "./syntaxes/ngin.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "ngin",
        "path": "./snippets/ngin.code-snippets"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ngin",
          "title": "NGIN",
          "icon": "media/ngin-activity.svg"
        }
      ]
    },
    "views": {
      "ngin": [
        {
          "id": "ngin.projects",
          "name": "Projects"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "ngin.projects",
        "when": "workspaceFolderCount == 0",
        "contents": "Open a folder containing an NGIN project to get started.\n[Open Folder](command:workbench.action.files.openFolder)\n[Open Getting Started](command:ngin.openWalkthrough)"
      },
      {
        "view": "ngin.projects",
        "when": "workspaceFolderCount > 0 && !ngin.hasProjects",
        "contents": "No NGIN projects were found in this workspace.\n[Create NGIN Project](command:ngin.createProject)\n[Refresh Projects](command:ngin.refresh)\n[Read the NGIN Tools Guide](command:ngin.openDocumentation)"
      }
    ],
    "walkthroughs": [
      {
        "id": "ngin.gettingStarted",
        "title": "Get started with NGIN",
        "description": "Set up the CLI, open or create a project, and run the native C++ workflow.",
        "steps": [
          {
            "id": "configureCli",
            "title": "Find the NGIN CLI",
            "description": "NGIN Tools uses the repository development build when available, then `ngin` on PATH. [Review NGIN settings](command:ngin.openSettings).",
            "media": { "markdown": "media/walkthrough/cli.md" },
            "completionEvents": ["onCommand:ngin.openSettings"]
          },
          {
            "id": "openProject",
            "title": "Open or create a project",
            "description": "Open a workspace with a `.nginproj`, or [create an NGIN project](command:ngin.createProject).",
            "media": { "markdown": "media/walkthrough/project.md" },
            "completionEvents": ["onCommand:ngin.createProject", "onContext:ngin.hasProject"]
          },
          {
            "id": "buildProject",
            "title": "Build, run, and debug",
            "description": "Click a project in the Projects view to select it, then use Configure, Build, Run, or Debug in the status bar. Press F5 to debug the project owning the active file.",
            "media": { "markdown": "media/walkthrough/build.md" },
            "completionEvents": ["onCommand:ngin.build", "onCommand:ngin.run", "onCommand:ngin.debug"]
          },
          {
            "id": "enableTooling",
            "title": "Enable analyzers and formatters",
            "description": "Projects can provide verified tooling through NGIN Actions. [Enable project tooling](command:ngin.enableProjectTooling) when your project declares it.",
            "media": { "markdown": "media/walkthrough/tooling.md" },
            "completionEvents": ["onCommand:ngin.enableProjectTooling"]
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "ngin.refresh",
        "title": "Refresh Workspace",
        "category": "NGIN",
        "icon": "$(refresh)"
      },
      {
        "command": "ngin.refreshGraph",
        "title": "Refresh Composition Graph",
        "category": "NGIN",
        "enablement": "ngin.hasProject && !ngin.busy",
        "icon": "$(refresh)"
      },
      {
        "command": "ngin.showFilesView",
        "title": "Show Files View",
        "category": "NGIN",
        "icon": "$(files)"
      },
      {
        "command": "ngin.showProjectView",
        "title": "Show Project View",
        "category": "NGIN",
        "icon": "$(list-tree)"
      },
      {
        "command": "ngin.setDefaultProject",
        "title": "Select Project",
        "category": "NGIN",
        "enablement": "ngin.hasProjects"
      },
      {
        "command": "ngin.selectConfiguration",
        "title": "Select Configuration",
        "category": "NGIN",
        "enablement": "ngin.hasProject && !ngin.busy"
      },
      {
        "command": "ngin.selectTarget",
        "title": "Select Platform Target",
        "category": "NGIN",
        "enablement": "ngin.hasProject && !ngin.busy"
      },
      {
        "command": "ngin.selectToolchain",
        "title": "Select Toolchain",
        "category": "NGIN",
        "enablement": "ngin.hasProject && !ngin.busy"
      },
      {
        "command": "ngin.selectPreset",
        "title": "Run Preset",
        "category": "NGIN",
        "enablement": "ngin.hasProject && !ngin.busy"
      },
      {
        "command": "ngin.setOption",
        "title": "Set Option Override",
        "category": "NGIN",
        "enablement": "ngin.hasGraph && !ngin.busy"
      },
      {
        "command": "ngin.clearOptions",
        "title": "Clear Option Overrides",
        "category": "NGIN",
        "enablement": "ngin.hasGraph && !ngin.busy"
      },
      {
        "command": "ngin.validate",
        "title": "Validate",
        "category": "NGIN",
        "enablement": "ngin.hasProject && !ngin.busy"
      },
      {
        "command": "ngin.validateManifest",
        "title": "Validate Manifest",
        "category": "NGIN",
        "enablement": "ngin.hasProject && !ngin.busy"
      },
      {
        "command": "ngin.restore",
        "title": "Restore Packages",
        "category": "NGIN",
        "enablement": "ngin.hasProject && !ngin.busy"
      },
      {
        "command": "ngin.lock",
        "title": "Lock Dependencies",
        "category": "NGIN",
        "enablement": "ngin.hasProject && !ngin.busy",
        "icon": "$(lock)"
      },
      {
        "command": "ngin.configure",
        "title": "Configure",
        "category": "NGIN",
        "enablement": "ngin.hasProject && !ngin.busy",
        "icon": "$(gear)"
      },
      {
        "command": "ngin.build",
        "title": "Build",
        "category": "NGIN",
        "enablement": "ngin.hasProject && !ngin.busy",
        "icon": "$(tools)"
      },
      {
        "command": "ngin.rebuild",
        "title": "Rebuild",
        "category": "NGIN",
        "enablement": "ngin.hasProject && !ngin.busy"
      },
      {
        "command": "ngin.clean",
        "title": "Clean Output",
        "category": "NGIN",
        "enablement": "ngin.hasProject && !ngin.busy"
      },
      {
        "command": "ngin.stage",
        "title": "Stage",
        "category": "NGIN",
        "enablement": "ngin.hasProject && !ngin.busy"
      },
      {
        "command": "ngin.run",
        "title": "Run",
        "category": "NGIN",
        "enablement": "ngin.canLaunch && !ngin.busy",
        "icon": "$(play)"
      },
      {
        "command": "ngin.runWithArguments",
        "title": "Run with Arguments",
        "category": "NGIN",
        "enablement": "ngin.canLaunch && !ngin.busy"
      },
      {
        "command": "ngin.debug",
        "title": "Debug",
        "category": "NGIN",
        "enablement": "ngin.canLaunch && !ngin.busy",
        "icon": "$(debug-alt)"
      },
      {
        "command": "ngin.test",
        "title": "Test",
        "category": "NGIN",
        "enablement": "ngin.hasTesting && !ngin.busy"
      },
      {
        "command": "ngin.publish",
        "title": "Publish",
        "category": "NGIN",
        "enablement": "ngin.hasProject && !ngin.busy"
      },
      {
        "command": "ngin.analyze",
        "title": "Analyze Project",
        "category": "NGIN",
        "enablement": "ngin.hasAnalyze && !ngin.busy"
      },
      {
        "command": "ngin.enableProjectTooling",
        "title": "Enable Analyzers and Formatters",
        "category": "NGIN",
        "enablement": "ngin.hasProject && !ngin.busy"
      },
      {
        "command": "ngin.analyzeFile",
        "title": "Analyze File",
        "category": "NGIN",
        "enablement": "ngin.hasProject && !ngin.busy"
      },
      {
        "command": "ngin.formatSources",
        "title": "Run Format Actions",
        "category": "NGIN",
        "enablement": "ngin.hasFormat && !ngin.busy"
      },
      {
        "command": "ngin.formatFile",
        "title": "Format File",
        "category": "NGIN",
        "enablement": "ngin.hasProject && !ngin.busy"
      },
      {
        "command": "ngin.formatManifest",
        "title": "Format Manifest",
        "category": "NGIN",
        "enablement": "ngin.hasProject && !ngin.busy"
      },
      {
        "command": "ngin.showGraph",
        "title": "Open Resolved Project JSON",
        "category": "NGIN",
        "enablement": "ngin.hasGraph"
      },
      {
        "command": "ngin.inspect",
        "title": "Inspect Project",
        "category": "NGIN",
        "enablement": "ngin.hasProject && !ngin.busy"
      },
      {
        "command": "ngin.diff",
        "title": "Diff Composition Against Project",
        "category": "NGIN",
        "enablement": "ngin.hasProject && !ngin.busy"
      },
      {
        "command": "ngin.explain",
        "title": "Explain Selection",
        "category": "NGIN",
        "enablement": "ngin.hasProject && !ngin.busy"
      },
      {
        "command": "ngin.openManifest",
        "title": "Open Project Manifest",
        "category": "NGIN",
        "enablement": "ngin.hasProject && !ngin.busy"
      },
      {
        "command": "ngin.openGraphSource",
        "title": "Open Declaring Source",
        "category": "NGIN",
        "enablement": "ngin.hasGraph"
      },
      {
        "command": "ngin.showOutput",
        "title": "Show Output",
        "category": "NGIN"
      },
      {
        "command": "ngin.cancel",
        "title": "Cancel Active Operation",
        "category": "NGIN",
        "enablement": "ngin.busy"
      },
      {
        "command": "ngin.openDashboard",
        "title": "Open Project Overview",
        "category": "NGIN",
        "icon": "$(dashboard)"
      },
      {
        "command": "ngin.createProject",
        "title": "Create Project",
        "category": "NGIN",
        "enablement": "workspaceFolderCount > 0"
      },
      {
        "command": "ngin.openSettings",
        "title": "Open Settings",
        "category": "NGIN"
      },
      {
        "command": "ngin.openDocumentation",
        "title": "Open Documentation",
        "category": "NGIN"
      },
      {
        "command": "ngin.openWalkthrough",
        "title": "Open Getting Started",
        "category": "NGIN"
      },
      {
        "command": "ngin.addPackage",
        "title": "Add Package",
        "category": "NGIN",
        "enablement": "ngin.hasProject && !ngin.busy"
      },
      {
        "command": "ngin.addProjectReference",
        "title": "Add Project Reference",
        "category": "NGIN",
        "enablement": "ngin.hasProject && !ngin.busy"
      },
      {
        "command": "ngin.addAction",
        "title": "Add Action",
        "category": "NGIN",
        "enablement": "ngin.hasProject && !ngin.busy"
      },
      {
        "command": "ngin.editProduct",
        "title": "Edit Product",
        "category": "NGIN",
        "enablement": "ngin.hasProject && !ngin.busy"
      },
      {
        "command": "ngin.newSourceFile",
        "title": "New C++ Source File",
        "category": "NGIN",
        "enablement": "ngin.hasProject && !ngin.busy",
        "icon": "$(new-file)"
      },
      {
        "command": "ngin.newHeaderFile",
        "title": "New C++ Header File",
        "category": "NGIN",
        "enablement": "ngin.hasProject && !ngin.busy",
        "icon": "$(new-file)"
      },
      {
        "command": "ngin.newFile",
        "title": "New File…",
        "category": "NGIN",
        "enablement": "ngin.hasProject && !ngin.busy",
        "icon": "$(new-file)"
      },
      {
        "command": "ngin.newFolder",
        "title": "New Project Folder",
        "category": "NGIN",
        "enablement": "ngin.hasProject && !ngin.busy",
        "icon": "$(new-folder)"
      },
      {
        "command": "ngin.includeFile",
        "title": "Include in Product",
        "category": "NGIN",
        "enablement": "ngin.hasProject && !ngin.busy"
      },
      {
        "command": "ngin.excludeFile",
        "title": "Exclude from Product",
        "category": "NGIN",
        "enablement": "ngin.hasProject && !ngin.busy"
      },
      {
        "command": "ngin.renameFile",
        "title": "Rename Project Item",
        "category": "NGIN",
        "enablement": "ngin.hasProject && !ngin.busy"
      },
      {
        "command": "ngin.duplicateFile",
        "title": "Duplicate Project File",
        "category": "NGIN",
        "enablement": "ngin.hasProject && !ngin.busy"
      },
      {
        "command": "ngin.deleteFile",
        "title": "Delete Project Item",
        "category": "NGIN",
        "enablement": "ngin.hasProject && !ngin.busy"
      },
      {
        "command": "ngin.revealFile",
        "title": "Reveal in File Explorer",
        "category": "NGIN",
        "enablement": "ngin.hasProject && !ngin.busy"
      },
      {
        "command": "ngin.revealOwningProject",
        "title": "Reveal Owning Project",
        "category": "NGIN",
        "enablement": "ngin.hasProject && !ngin.busy"
      }
    ],
    "submenus": [
      {
        "id": "ngin.sourceMenu",
        "label": "NGIN"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "ngin.showFilesView",
          "when": "view == ngin.projects && ngin.projectsViewMode == project",
          "group": "navigation@1"
        },
        {
          "command": "ngin.showProjectView",
          "when": "view == ngin.projects && ngin.projectsViewMode == files",
          "group": "navigation@1"
        },
        {
          "command": "ngin.refresh",
          "when": "view == ngin.projects",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "ngin.newSourceFile",
          "when": "view == ngin.projects && viewItem == nginSourcesGroup",
          "group": "inline@1"
        },
        {
          "command": "ngin.newHeaderFile",
          "when": "view == ngin.projects && viewItem == nginHeadersGroup",
          "group": "inline@1"
        },
        {
          "command": "ngin.build",
          "when": "view == ngin.projects && viewItem =~ /^nginProjectRoot/",
          "group": "inline@1"
        },
        {
          "command": "ngin.run",
          "when": "view == ngin.projects && viewItem =~ /^nginProjectRoot.*\\.launch(\\.|$)/",
          "group": "inline@2"
        },
        {
          "command": "ngin.debug",
          "when": "view == ngin.projects && viewItem =~ /^nginProjectRoot.*\\.launch(\\.|$)/",
          "group": "inline@3"
        },
        {
          "command": "ngin.build",
          "when": "view == ngin.projects && viewItem =~ /^nginProjectRoot/",
          "group": "1_lifecycle@1"
        },
        {
          "command": "ngin.run",
          "when": "view == ngin.projects && viewItem =~ /^nginProjectRoot.*\\.launch(\\.|$)/",
          "group": "1_lifecycle@2"
        },
        {
          "command": "ngin.debug",
          "when": "view == ngin.projects && viewItem =~ /^nginProjectRoot.*\\.launch(\\.|$)/",
          "group": "1_lifecycle@3"
        },
        {
          "command": "ngin.test",
          "when": "view == ngin.projects && viewItem =~ /^nginProjectRoot.*\\.test(\\.|$)/",
          "group": "1_lifecycle@4"
        },
        {
          "command": "ngin.configure",
          "when": "view == ngin.projects && viewItem =~ /^nginProjectRoot/",
          "group": "1_lifecycle@5"
        },
        {
          "command": "ngin.stage",
          "when": "view == ngin.projects && viewItem =~ /^nginProjectRoot/",
          "group": "1_lifecycle@6"
        },
        {
          "command": "ngin.analyze",
          "when": "view == ngin.projects && viewItem =~ /^nginProjectRoot.*\\.analyze(\\.|$)/",
          "group": "2_tooling@1"
        },
        {
          "command": "ngin.formatSources",
          "when": "view == ngin.projects && viewItem =~ /^nginProjectRoot.*\\.format(\\.|$)/",
          "group": "2_tooling@2"
        },
        {
          "command": "ngin.enableProjectTooling",
          "when": "view == ngin.projects && viewItem =~ /^nginProjectRoot/",
          "group": "2_tooling@3"
        },
        {
          "command": "ngin.setDefaultProject",
          "when": "view == ngin.projects && viewItem =~ /^nginProjectRoot/",
          "group": "3_project@1"
        },
        {
          "command": "ngin.openDashboard",
          "when": "view == ngin.projects && viewItem =~ /^nginProjectRoot/",
          "group": "3_project@2"
        },
        {
          "command": "ngin.openManifest",
          "when": "view == ngin.projects && viewItem =~ /^nginProjectRoot/",
          "group": "3_project@3"
        },
        {
          "command": "ngin.newFile",
          "when": "view == ngin.projects && (viewItem =~ /^nginProjectRoot/ || viewItem == nginProjectDirectory.unselected)",
          "group": "3_project@6"
        },
        {
          "command": "ngin.newSourceFile",
          "when": "view == ngin.projects && (viewItem =~ /^nginProjectRoot/ || viewItem == nginSourcesGroup)",
          "group": "3_project@4"
        },
        {
          "command": "ngin.newHeaderFile",
          "when": "view == ngin.projects && (viewItem =~ /^nginProjectRoot/ || viewItem == nginHeadersGroup)",
          "group": "3_project@5"
        },
        {
          "command": "ngin.newFolder",
          "when": "view == ngin.projects && (viewItem =~ /^nginProjectRoot/ || viewItem == nginProjectDirectory.unselected)",
          "group": "3_project@5"
        },
        {
          "command": "ngin.restore",
          "when": "view == ngin.projects && viewItem =~ /^nginProjectRoot/",
          "group": "4_dependencies@1"
        },
        {
          "command": "ngin.lock",
          "when": "view == ngin.projects && viewItem =~ /^nginProjectRoot/",
          "group": "4_dependencies@2"
        },
        {
          "command": "ngin.clean",
          "when": "view == ngin.projects && viewItem =~ /^nginProjectRoot/",
          "group": "5_advanced@1"
        },
        {
          "command": "ngin.showGraph",
          "when": "view == ngin.projects && viewItem =~ /^nginProjectRoot/",
          "group": "5_advanced@2"
        },
        {
          "command": "ngin.inspect",
          "when": "view == ngin.projects && viewItem =~ /^nginProjectRoot/",
          "group": "5_advanced@3"
        },
        {
          "command": "ngin.includeFile",
          "when": "view == ngin.projects && viewItem == nginProjectFile.unselected",
          "group": "1_membership@1"
        },
        {
          "command": "ngin.excludeFile",
          "when": "view == ngin.projects && (viewItem == nginProjectFile.selected || viewItem == nginProjectFile.missing)",
          "group": "1_membership@2"
        },
        {
          "command": "ngin.analyzeFile",
          "when": "view == ngin.projects && (viewItem == nginProjectFile.selected || viewItem == nginProjectFile.unselected) && resourceExtname =~ /\\.(c|cc|cpp|cxx|h|hh|hpp|hxx|ixx|cppm)$/",
          "group": "1_tooling@1"
        },
        {
          "command": "ngin.formatFile",
          "when": "view == ngin.projects && (viewItem == nginProjectFile.selected || viewItem == nginProjectFile.unselected) && resourceExtname =~ /\\.(c|cc|cpp|cxx|h|hh|hpp|hxx|ixx|cppm)$/",
          "group": "1_tooling@2"
        },
        {
          "command": "ngin.renameFile",
          "when": "view == ngin.projects && (viewItem == nginProjectFile.selected || viewItem == nginProjectFile.unselected || viewItem == nginProjectDirectory.unselected)",
          "group": "2_file@1"
        },
        {
          "command": "ngin.duplicateFile",
          "when": "view == ngin.projects && (viewItem == nginProjectFile.selected || viewItem == nginProjectFile.unselected)",
          "group": "2_file@2"
        },
        {
          "command": "ngin.deleteFile",
          "when": "view == ngin.projects && (viewItem == nginProjectFile.selected || viewItem == nginProjectFile.unselected || viewItem == nginProjectDirectory.unselected)",
          "group": "2_file@3"
        },
        {
          "command": "ngin.revealFile",
          "when": "view == ngin.projects && (viewItem =~ /^nginProjectFile\\.(authored|selected|unselected|generated|external)$/ || viewItem =~ /^nginProjectDirectory\\.(unselected|external|boundary)$/)",
          "group": "3_navigation@1"
        }
      ],
      "editor/title": [
        {
          "command": "ngin.validateManifest",
          "when": "editorLangId == ngin",
          "group": "navigation@1"
        },
        {
          "command": "ngin.formatManifest",
          "when": "editorLangId == ngin",
          "group": "navigation@2"
        }
      ],
      "editor/context": [
        {
          "submenu": "ngin.sourceMenu",
          "when": "resourceScheme == file",
          "group": "navigation@20"
        }
      ],
      "explorer/context": [
        {
          "submenu": "ngin.sourceMenu",
          "when": "resourceScheme == file",
          "group": "navigation@20"
        }
      ],
      "ngin.sourceMenu": [
        {
          "command": "ngin.analyzeFile",
          "when": "resourceExtname =~ /\\.(c|cc|cpp|cxx|h|hh|hpp|hxx|ixx|cppm)$/",
          "group": "1_tooling@1"
        },
        {
          "command": "ngin.formatFile",
          "when": "resourceExtname =~ /\\.(c|cc|cpp|cxx|h|hh|hpp|hxx|ixx|cppm)$/",
          "group": "1_tooling@2"
        },
        {
          "command": "ngin.includeFile",
          "when": "resourceExtname =~ /\\.(c|cc|cpp|cxx|h|hh|hpp|hxx|ixx|cppm)$/",
          "group": "2_membership@1"
        },
        {
          "command": "ngin.excludeFile",
          "when": "resourceExtname =~ /\\.(c|cc|cpp|cxx|h|hh|hpp|hxx|ixx|cppm)$/",
          "group": "2_membership@2"
        },
        {
          "command": "ngin.revealOwningProject",
          "group": "3_navigation@1"
        }
      ],
      "commandPalette": [
        {
          "command": "ngin.cancel",
          "when": "ngin.busy"
        },
        {
          "command": "ngin.openGraphSource",
          "when": "false"
        },
        {
          "command": "ngin.includeFile",
          "when": "false"
        },
        {
          "command": "ngin.excludeFile",
          "when": "false"
        },
        {
          "command": "ngin.renameFile",
          "when": "false"
        },
        {
          "command": "ngin.duplicateFile",
          "when": "false"
        },
        {
          "command": "ngin.deleteFile",
          "when": "false"
        },
        {
          "command": "ngin.revealFile",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "NGIN",
      "properties": {
        "ngin.executable": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to the `ngin` executable. Empty automatically uses the repository development build when present, then `ngin` on PATH."
        },
        "ngin.validateOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Validate the active NGIN project after saving an NGIN manifest."
        },
        "ngin.analysis.mode": {
          "type": "string",
          "enum": ["off", "openAndSave"],
          "enumDescriptions": [
            "Do not run project analyzers automatically.",
            "Analyze C and C++ files when they are opened or saved."
          ],
          "default": "openAndSave",
          "description": "Run resolved project analyzers when a C/C++ file is opened or saved."
        },
        "ngin.analysis.debounceMs": {
          "type": "number",
          "minimum": 0,
          "default": 400,
          "description": "Delay before analyzing a saved source file."
        },
        "ngin.build.outputRoot": {
          "type": "string",
          "default": "build/ngin",
          "description": "Workspace-relative or absolute root for extension-driven build output."
        },
        "ngin.revealOutputOnRun": {
          "type": "boolean",
          "default": false,
          "description": "Reveal the NGIN output channel when starting a lifecycle command. Failure messages provide an action to open it."
        },
        "ngin.statusBar.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show the selected NGIN project plus Configure, Build, Run, and Debug actions in the status bar."
        },
        "ngin.decorations.mode": {
          "type": "string",
          "enum": ["off", "minimal", "detailed"],
          "enumDescriptions": [
            "Do not decorate files in the Explorer.",
            "Decorate only exceptional NGIN files such as generated inputs.",
            "Decorate included, excluded, generated, and project-owned files."
          ],
          "default": "minimal",
          "description": "Controls NGIN file decorations in the Explorer."
        },
        "ngin.cpp.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Provide compile-command configuration to the Microsoft C/C++ extension when installed."
        },
        "ngin.debug.miDebuggerPath": {
          "type": "string",
          "default": "",
          "description": "Optional GDB or LLDB executable for NGIN native debugging on Linux and macOS."
        }
      }
    },
    "taskDefinitions": [
      {
        "type": "ngin",
        "required": [
          "command"
        ],
        "properties": {
          "command": {
            "type": "string",
            "enum": [
              "configure",
              "build",
              "stage",
              "test",
              "restore"
            ]
          }
        }
      }
    ],
    "problemMatchers": [
      {
        "name": "ngin-file",
        "label": "NGIN manifest diagnostics",
        "owner": "ngin",
        "fileLocation": "absolute",
        "pattern": {
          "regexp": "^(.*):(\\d+):(\\d+):\\s+(error|warning)\\s+(NGIN\\d+):\\s+(.+)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "code": 5,
          "message": 6
        }
      }
    ],
    "debuggers": [
      {
        "type": "ngin",
        "label": "NGIN Native",
        "configurationAttributes": {
          "launch": {
            "properties": {
              "project": {
                "type": "string",
                "description": "Optional .nginproj path; defaults to the project owning the active source file, then the default project."
              },
              "configuration": {
                "type": "string",
                "description": "Optional NGIN Configuration."
              },
              "target": {
                "type": "string",
                "description": "Optional NGIN Target."
              },
              "toolchain": {
                "type": "string",
                "description": "Optional NGIN Toolchain."
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": []
              },
              "preStage": {
                "type": "boolean",
                "default": true,
                "description": "Build and stage before starting the native debugger."
              },
              "test": {
                "type": "boolean",
                "default": false,
                "description": "Debug the resolved NGIN TestPlan instead of a Launch definition."
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "ngin",
            "request": "launch",
            "name": "NGIN: Debug Current Project",
            "preStage": true
          }
        ]
      }
    ]
  },
  "dependencies": {
    "vscode-cpptools": "^7.1.1"
  }
}
