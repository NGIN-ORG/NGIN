{
  "name": "ngin-tools",
  "displayName": "NGIN Tools",
  "description": "A graph-driven project, build, run, debug, and XML authoring experience for NGIN.",
  "version": "0.1.0",
  "publisher": "ngin",
  "license": "Apache-2.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/NGIN-ORG/NGIN.git",
    "directory": "Tools/NGIN.VSCode"
  },
  "engines": {
    "vscode": "^1.86.0"
  },
  "categories": [
    "Programming Languages",
    "Debuggers",
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:**/*.ngin",
    "workspaceContains:**/*.nginproj",
    "onDebugResolve:ngin"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "watch": "node ./scripts/build.mjs --watch",
    "typecheck": "tsc -p ./tsconfig.json --noEmit",
    "test:unit": "node ./scripts/test.mjs",
    "test:integration": "npm run build && node ./scripts/test.mjs --compile-only && node ./dist-test/test/integration/runTest.js",
    "test": "npm run typecheck && npm run test:unit && npm run test:integration",
    "vscode:prepublish": "npm run build",
    "package": "vsce package --out ngin-tools.vsix"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "@types/vscode": "^1.86.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.1",
    "ovsx": "^0.10.12",
    "typescript": "^6.0.3"
  },
  "contributes": {
    "languages": [
      {
        "id": "ngin",
        "aliases": [
          "NGIN Manifest"
        ],
        "extensions": [
          ".ngin",
          ".nginproj",
          ".nginpkg"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "ngin",
        "scopeName": "source.ngin",
        "path": "./syntaxes/ngin.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "ngin",
        "path": "./snippets/ngin.code-snippets"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ngin",
          "title": "NGIN",
          "icon": "media/ngin-activity.svg"
        }
      ]
    },
    "views": {
      "ngin": [
        {
          "id": "ngin.projects",
          "name": "Projects"
        }
      ]
    },
    "commands": [
      {
        "command": "ngin.refresh",
        "title": "NGIN: Refresh Workspace",
        "icon": "$(refresh)"
      },
      {
        "command": "ngin.refreshGraph",
        "title": "NGIN: Refresh Composition Graph",
        "icon": "$(refresh)"
      },
      {
        "command": "ngin.switchBuildTarget",
        "title": "NGIN: Switch Build Target"
      },
      {
        "command": "ngin.selectConfiguration",
        "title": "NGIN: Select Configuration"
      },
      {
        "command": "ngin.selectTarget",
        "title": "NGIN: Select Target"
      },
      {
        "command": "ngin.selectToolchain",
        "title": "NGIN: Select Toolchain"
      },
      {
        "command": "ngin.selectPreset",
        "title": "NGIN: Run Preset"
      },
      {
        "command": "ngin.setOption",
        "title": "NGIN: Set Option Override"
      },
      {
        "command": "ngin.clearOptions",
        "title": "NGIN: Clear Option Overrides"
      },
      {
        "command": "ngin.validate",
        "title": "NGIN: Validate"
      },
      {
        "command": "ngin.validateManifest",
        "title": "NGIN: Validate Manifest"
      },
      {
        "command": "ngin.restore",
        "title": "NGIN: Restore Packages"
      },
      {
        "command": "ngin.lock",
        "title": "NGIN: Lock Dependencies",
        "icon": "$(lock)"
      },
      {
        "command": "ngin.configure",
        "title": "NGIN: Configure",
        "icon": "$(gear)"
      },
      {
        "command": "ngin.build",
        "title": "NGIN: Build",
        "icon": "$(tools)"
      },
      {
        "command": "ngin.rebuild",
        "title": "NGIN: Rebuild"
      },
      {
        "command": "ngin.clean",
        "title": "NGIN: Clean Output"
      },
      {
        "command": "ngin.stage",
        "title": "NGIN: Stage"
      },
      {
        "command": "ngin.run",
        "title": "NGIN: Run",
        "icon": "$(play)"
      },
      {
        "command": "ngin.debug",
        "title": "NGIN: Debug",
        "icon": "$(debug-alt)"
      },
      {
        "command": "ngin.test",
        "title": "NGIN: Test"
      },
      {
        "command": "ngin.publish",
        "title": "NGIN: Publish"
      },
      {
        "command": "ngin.analyze",
        "title": "NGIN: Analyze Project"
      },
      {
        "command": "ngin.enableProjectTooling",
        "title": "NGIN: Enable Project Tooling"
      },
      {
        "command": "ngin.analyzeFile",
        "title": "NGIN: Analyze File"
      },
      {
        "command": "ngin.formatSources",
        "title": "NGIN: Run Format Actions"
      },
      {
        "command": "ngin.formatFile",
        "title": "NGIN: Format File"
      },
      {
        "command": "ngin.formatManifest",
        "title": "NGIN: Format Manifest"
      },
      {
        "command": "ngin.showGraph",
        "title": "NGIN: Show Composition Graph"
      },
      {
        "command": "ngin.inspect",
        "title": "NGIN: Inspect Project"
      },
      {
        "command": "ngin.diff",
        "title": "NGIN: Diff Composition Against Project"
      },
      {
        "command": "ngin.explain",
        "title": "NGIN: Explain Selection"
      },
      {
        "command": "ngin.openManifest",
        "title": "NGIN: Open Project Manifest"
      },
      {
        "command": "ngin.openGraphSource",
        "title": "NGIN: Open Declaring Source"
      },
      {
        "command": "ngin.showOutput",
        "title": "NGIN: Show Output"
      },
      {
        "command": "ngin.cancel",
        "title": "NGIN: Cancel Active Operation"
      },
      {
        "command": "ngin.openDashboard",
        "title": "NGIN: Open Project Dashboard"
      },
      {
        "command": "ngin.addPackage",
        "title": "NGIN: Add Package"
      },
      {
        "command": "ngin.addProjectReference",
        "title": "NGIN: Add Project Reference"
      },
      {
        "command": "ngin.addAction",
        "title": "NGIN: Add Action"
      },
      {
        "command": "ngin.editProduct",
        "title": "NGIN: Edit Product"
      },
      {
        "command": "ngin.newFile",
        "title": "NGIN: New Project File",
        "icon": "$(new-file)"
      },
      {
        "command": "ngin.newFolder",
        "title": "NGIN: New Project Folder",
        "icon": "$(new-folder)"
      },
      {
        "command": "ngin.includeFile",
        "title": "NGIN: Include in Product"
      },
      {
        "command": "ngin.excludeFile",
        "title": "NGIN: Exclude from Product"
      },
      {
        "command": "ngin.renameFile",
        "title": "NGIN: Rename Project Item"
      },
      {
        "command": "ngin.duplicateFile",
        "title": "NGIN: Duplicate Project File"
      },
      {
        "command": "ngin.deleteFile",
        "title": "NGIN: Delete Project Item"
      },
      {
        "command": "ngin.revealFile",
        "title": "NGIN: Reveal in File Explorer"
      },
      {
        "command": "ngin.revealOwningProject",
        "title": "NGIN: Reveal Owning Project"
      }
    ],
    "submenus": [
      {
        "id": "ngin.sourceMenu",
        "label": "NGIN"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "ngin.refresh",
          "when": "view == ngin.projects",
          "group": "navigation"
        },
        {
          "command": "ngin.refreshGraph",
          "when": "view == ngin.projects",
          "group": "navigation"
        },
        {
          "command": "ngin.openDashboard",
          "when": "view == ngin.projects",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "ngin.build",
          "when": "view == ngin.projects && viewItem == nginProject",
          "group": "inline@1"
        },
        {
          "command": "ngin.run",
          "when": "view == ngin.projects && viewItem == nginProject",
          "group": "inline@2"
        },
        {
          "command": "ngin.debug",
          "when": "view == ngin.projects && viewItem == nginProject",
          "group": "inline@3"
        },
        {
          "command": "ngin.switchBuildTarget",
          "when": "view == ngin.projects && viewItem == nginProject",
          "group": "ngin.project@1"
        },
        {
          "command": "ngin.openManifest",
          "when": "view == ngin.projects && viewItem == nginProject",
          "group": "ngin.project@2"
        }
      ],
      "editor/title": [
        {
          "command": "ngin.validateManifest",
          "when": "editorLangId == ngin",
          "group": "navigation@1"
        },
        {
          "command": "ngin.formatManifest",
          "when": "editorLangId == ngin",
          "group": "navigation@2"
        }
      ],
      "editor/context": [
        {
          "submenu": "ngin.sourceMenu",
          "when": "resourceScheme == file",
          "group": "navigation@20"
        }
      ],
      "explorer/context": [
        {
          "submenu": "ngin.sourceMenu",
          "when": "resourceScheme == file",
          "group": "navigation@20"
        }
      ],
      "ngin.sourceMenu": [
        {
          "command": "ngin.analyzeFile",
          "when": "resourceExtname =~ /\\.(c|cc|cpp|cxx|h|hh|hpp|hxx|ixx|cppm)$/",
          "group": "1_tooling@1"
        },
        {
          "command": "ngin.formatFile",
          "when": "resourceExtname =~ /\\.(c|cc|cpp|cxx|h|hh|hpp|hxx|ixx|cppm)$/",
          "group": "1_tooling@2"
        },
        {
          "command": "ngin.includeFile",
          "when": "resourceExtname =~ /\\.(c|cc|cpp|cxx|h|hh|hpp|hxx|ixx|cppm)$/",
          "group": "2_membership@1"
        },
        {
          "command": "ngin.excludeFile",
          "when": "resourceExtname =~ /\\.(c|cc|cpp|cxx|h|hh|hpp|hxx|ixx|cppm)$/",
          "group": "2_membership@2"
        },
        {
          "command": "ngin.revealOwningProject",
          "group": "3_navigation@1"
        }
      ],
      "commandPalette": [
        {
          "command": "ngin.cancel",
          "when": "ngin.busy"
        }
      ]
    },
    "configuration": {
      "title": "NGIN",
      "properties": {
        "ngin.executable": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to the `ngin` executable. Empty automatically uses the repository development build when present, then `ngin` on PATH."
        },
        "ngin.validateOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Validate the active NGIN project after saving an NGIN manifest."
        },
        "ngin.analysis.mode": {
          "type": "string",
          "enum": ["off", "openAndSave"],
          "default": "openAndSave",
          "description": "Run resolved project analyzers when a C/C++ file is opened or saved."
        },
        "ngin.analysis.debounceMs": {
          "type": "number",
          "minimum": 0,
          "default": 400,
          "description": "Delay before analyzing a saved source file."
        },
        "ngin.build.outputRoot": {
          "type": "string",
          "default": "build/ngin",
          "description": "Workspace-relative or absolute root for extension-driven build output."
        },
        "ngin.revealOutputOnRun": {
          "type": "boolean",
          "default": false,
          "description": "Reveal the NGIN output channel when starting a lifecycle command. Failures always reveal it."
        },
        "ngin.statusBar.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show the pinned Build/Run target and its current state in the status bar."
        },
        "ngin.cpp.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Provide compile-command configuration to the Microsoft C/C++ extension when installed."
        },
        "ngin.debug.miDebuggerPath": {
          "type": "string",
          "default": "",
          "description": "Optional GDB or LLDB executable for NGIN native debugging on Linux and macOS."
        }
      }
    },
    "taskDefinitions": [
      {
        "type": "ngin",
        "required": [
          "command"
        ],
        "properties": {
          "command": {
            "type": "string",
            "enum": [
              "configure",
              "build",
              "stage",
              "test",
              "restore"
            ]
          }
        }
      }
    ],
    "problemMatchers": [
      {
        "name": "ngin-file",
        "label": "NGIN manifest diagnostics",
        "owner": "ngin",
        "fileLocation": "absolute",
        "pattern": {
          "regexp": "^(.*):(\\d+):(\\d+):\\s+(error|warning)\\s+(NGIN\\d+):\\s+(.+)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "code": 5,
          "message": 6
        }
      }
    ],
    "debuggers": [
      {
        "type": "ngin",
        "label": "NGIN Native",
        "configurationAttributes": {
          "launch": {
            "properties": {
              "project": {
                "type": "string",
                "description": "Optional .nginproj path; defaults to the project owning the active source file, then the pinned Build target."
              },
              "configuration": {
                "type": "string",
                "description": "Optional NGIN Configuration."
              },
              "target": {
                "type": "string",
                "description": "Optional NGIN Target."
              },
              "toolchain": {
                "type": "string",
                "description": "Optional NGIN Toolchain."
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": []
              },
              "preStage": {
                "type": "boolean",
                "default": true,
                "description": "Build and stage before starting the native debugger."
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "ngin",
            "request": "launch",
            "name": "NGIN: Debug Current Project",
            "preStage": true
          }
        ]
      }
    ]
  },
  "dependencies": {
    "vscode-cpptools": "^7.1.1"
  }
}
