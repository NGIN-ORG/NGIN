{
  "NGIN project": {
    "prefix": "ngin-project",
    "body": [
      "<Project Name=\"${1:App}\" Type=\"${2|Application,Library,Tool,Test,Benchmark,Plugin,External|}\">",
      "  <Build><Source Include=\"src/**/*.cpp\" /></Build>",
      "</Project>"
    ]
  },
  "NGIN package dependency": {
    "prefix": "ngin-dependency",
    "body": ["<Package Name=\"${1:Package}\" Compatible=\"${2:1}\" />"]
  },
  "NGIN package": {
    "prefix": "ngin-package",
    "body": [
      "<Package Name=\"${1:Package}\" Version=\"${2:1.0.0}\">",
      "  <Exports><Library Name=\"${3:Core}\" Default=\"true\" /></Exports>",
      "</Package>"
    ]
  },
  "NGIN workspace": {
    "prefix": "ngin-workspace",
    "body": [
      "<Workspace Name=\"${1:Workspace}\">",
      "  <Projects><Project Include=\"${2:apps/**/*.nginproj}\" /></Projects>",
      "</Workspace>"
    ]
  }
}
