{
  "NGIN executable project": {
    "prefix": "ngin-executable",
    "body": [
      "<Executable Name=\"${1:Product}\">",
      "  <Build><Source Include=\"src/**/*.cpp\" /></Build>",
      "</Executable>"
    ]
  },
  "NGIN library project": {
    "prefix": "ngin-library",
    "body": [
      "<Library Name=\"${1:Product}\" Kind=\"${2|Static,Shared,Interface,Plugin|}\">",
      "  <Build><Source Include=\"src/**/*.cpp\" /></Build>",
      "</Library>"
    ]
  },
  "NGIN package dependency": {
    "prefix": "ngin-dependency",
    "body": ["<Package Name=\"${1:Package}\" Version=\"${2:1}\" />"]
  },
  "NGIN package": {
    "prefix": "ngin-package",
    "body": [
      "<Package Name=\"${1:Package}\" Version=\"${2:1.0.0}\">",
      "  <Library Name=\"${3:Core}\" Default=\"true\" />",
      "</Package>"
    ]
  },
  "NGIN workspace": {
    "prefix": "ngin-workspace",
    "body": [
      "<Workspace Name=\"${1:Workspace}\">",
      "  <Discover><Projects Include=\"${2:apps/**/*.nginproj}\" /></Discover>",
      "</Workspace>"
    ]
  }
}
