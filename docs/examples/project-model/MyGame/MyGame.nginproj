<?xml version="1.0" encoding="utf-8"?>

<Executable Name="MyGame">
  <Uses>
    <Package Name="NGIN.Core" Version="0.1" />
    <Package Name="NGIN.ECS" Version="0.1" />
    <Package Name="SDL2">
      <Version AtLeast="2.30.0" Before="3.0.0" />
    </Package>
  </Uses>
  <Build>
    <Source Include="src/**/*.cpp" />
  </Build>
  <Stage>
    <File From="config/game.xml" To="config/game.xml" />
  </Stage>
</Executable>
