<?xml version="1.0" encoding="utf-8"?>

<Executable Name="NGIN.Samples.ApplicationModel">
  <Options>
    <Enum Name="Experience" Default="Game">
      <Value Name="Game" />
      <Value Name="ToolsCLI" />
      <Value Name="ToolsDiagnostics" />
    </Enum>
  </Options>
  <Uses>
    <Package Name="NGIN.Core" Version="0.1" />
    <Package Name="NGIN.ECS" Version="0.1" />
  </Uses>
  <Build>
    <Source Include="src/**/*.cpp" />
  </Build>
  <When Option="Experience" Equals="Game">
    <Stage>
      <File From="config/game.xml" To="config/app.xml" />
    </Stage>
  </When>
  <When Option="Experience" Equals="ToolsCLI">
    <Stage>
      <File From="config/cli.xml" To="config/app.xml" />
    </Stage>
  </When>
  <When Option="Experience" Equals="ToolsDiagnostics">
    <Uses>
      <Package Name="NGIN.Reflection" Version="0.1" />
      <Package Name="NGIN.Diagnostics" Version="0.1">
        <Plugin Name="Diagnostics" />
      </Package>
    </Uses>
    <Stage>
      <File From="config/tooling.xml" To="config/app.xml" />
    </Stage>
  </When>
</Executable>
