<?xml version="1.0" encoding="utf-8"?>
<Project Name="NGIN.Samples.ApplicationModel" Type="Application">
  <Options>
    <Enum Name="Experience" Default="Game">
      <Value Name="Game" />
      <Value Name="ToolsCLI" />
      <Value Name="ToolsDiagnostics" />
    </Enum>
  </Options>
  <Dependencies>
    <Package Name="NGIN.Core" Compatible="0.1" />
    <Package Name="NGIN.ECS" Compatible="0.1" />
  </Dependencies>
  <Build><Source Include="src/**/*.cpp" /></Build>
  <Launch Name="app" Default="true"><Executable Product="NGIN.Samples.ApplicationModel" /><WorkingDirectory Path="." /></Launch>
  <Refinements>
    <Refinement>
      <Select><Option Name="Experience" Value="Game" /></Select>
      <Stage><File Include="config/game.xml" Into="config/app.xml" /></Stage>
    </Refinement>
    <Refinement>
      <Select><Option Name="Experience" Value="ToolsCLI" /></Select>
      <Stage><File Include="config/cli.xml" Into="config/app.xml" /></Stage>
    </Refinement>
    <Refinement>
      <Select><Option Name="Experience" Value="ToolsDiagnostics" /></Select>
      <Dependencies>
        <Package Name="NGIN.Reflection" Compatible="0.1" />
        <Package Name="NGIN.Diagnostics" Compatible="0.1"><Use Plugin="Diagnostics" /></Package>
      </Dependencies>
      <Stage><File Include="config/tooling.xml" Into="config/app.xml" /></Stage>
    </Refinement>
  </Refinements>
</Project>
